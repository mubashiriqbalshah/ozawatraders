NODE_ENV=production
PORT=8000
# Generate a strong random secret (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# WhatsApp notifications (CallMeBot — free)
# 1. From the WhatsApp number set in WHATSAPP_TARGET, save +34 644 51 95 23 as a contact and send: "I allow callmebot to send me messages"
# 2. Bot replies with an API key. Paste it here.
WHATSAPP_TARGET=923167972059
CALLMEBOT_API_KEY=

# Email notifications (Gmail SMTP)
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate an App Password: https://myaccount.google.com/apppasswords (App: Mail, Device: "Ozawa Site")
# 3. Paste the 16-character app password (no spaces) into SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mubashir2009@gmail.com
SMTP_PASS=
EMAIL_TO=mubashir2009@gmail.com
