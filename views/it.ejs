<!DOCTYPE html>
<html lang="en">
<head>
    <% const it = content.it || {}; const pageTitle = (it.hero_title || 'IT & Software Solutions') + ' — ' + content.site.name; %>
    <%- include('partials/head', { pageTitle }) %>
</head>
<body class="text-navy-900 antialiased page-navy">
    <%- include('partials/header') %>

    <!-- Hero -->
    <section class="hero-bg relative overflow-hidden text-white pt-28 md:pt-32 lg:pt-40 pb-20 lg:pb-28">
        <div class="hero-grid absolute inset-0"></div>
        <div class="hero-watermark"><img src="<%= content.site.logo %>" alt=""></div>
        <div class="relative max-w-7xl mx-auto px-6">
            <a href="/" class="inline-flex items-center gap-2 text-blue-300 hover:text-blue-200 text-sm font-medium mb-6">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                Back to Home
            </a>
            <div class="max-w-3xl">
                <span class="inline-block px-3 py-1 rounded-full bg-blue-500/15 text-blue-300 border border-blue-500/30 text-sm font-semibold mb-4"><%= it.hero_badge || 'IT & Software Division' %></span>
                <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-extrabold leading-tight mb-4"><%= it.hero_title %></h1>
                <p class="text-lg text-navy-200 leading-relaxed"><%= it.hero_subtitle %></p>
                <div class="mt-8 flex flex-wrap gap-3">
                    <a href="#tenders" class="btn-accent">
                        Government Tenders
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
                    </a>
                    <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-semibold text-white border border-white/25 hover:bg-white/10 transition">
                        Request a Quote
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Intro -->
    <% if (it.intro_title || it.intro_paragraph) { %>
    <section class="py-16 lg:py-20 bg-white/55 backdrop-blur-[2px]">
        <div class="max-w-4xl mx-auto px-6 text-center">
            <% if (it.intro_title) { %>
            <h2 class="font-display text-2xl md:text-3xl lg:text-4xl font-extrabold text-navy-900 mb-4"><%= it.intro_title %></h2>
            <div class="accent-divider mt-2 mb-6 mx-auto"></div>
            <% } %>
            <% if (it.intro_paragraph) { %>
            <p class="text-navy-700 text-lg leading-relaxed"><%= it.intro_paragraph %></p>
            <% } %>
        </div>
    </section>
    <% } %>

    <!-- Services -->
    <% if (it.services && it.services.length) { %>
    <section class="pb-16 lg:pb-24 bg-white/55 backdrop-blur-[2px]">
        <div class="max-w-7xl mx-auto px-6">
            <div class="text-center max-w-2xl mx-auto mb-12">
                <% if (it.services_subtitle) { %><span class="premium-badge mb-3"><%= it.services_subtitle %></span><% } %>
                <h2 class="font-display text-2xl md:text-3xl lg:text-4xl font-extrabold text-navy-900 mt-3 mb-3"><%= it.services_title || 'Our IT & Software Services' %></h2>
                <% if (it.services_description) { %><p class="text-navy-600"><%= it.services_description %></p><% } %>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                <% it.services.forEach(s => { %>
                <article class="product-card rounded-2xl bg-white border border-navy-100 shadow-card hover:shadow-card-hover p-6 flex flex-col">
                    <div class="icon-wrap w-12 h-12 rounded-xl bg-gradient-to-br from-blue-500 to-brand text-white flex items-center justify-center shadow-sm mb-4">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    </div>
                    <h3 class="font-display text-lg font-extrabold text-navy-900 mb-2"><%= s.title %></h3>
                    <p class="text-navy-700 text-sm leading-relaxed"><%= s.description %></p>
                </article>
                <% }) %>
            </div>
        </div>
    </section>
    <% } %>

    <!-- Government Tenders / PPRA -->
    <% const t = it.tenders || {}; %>
    <section id="tenders" class="py-20 lg:py-28 bg-navy-950 text-white relative scroll-mt-24">
        <div class="absolute top-0 left-0 right-0 h-[3px] bg-gradient-to-r from-transparent via-gold-500 to-transparent"></div>
        <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-2 gap-12 items-center">
            <div>
                <% if (t.subtitle) { %>
                <span class="inline-block px-3 py-1 rounded-full bg-blue-500/15 text-blue-300 border border-blue-500/30 text-sm font-semibold mb-4"><%= t.subtitle %></span>
                <% } %>
                <h2 class="font-display text-3xl md:text-4xl font-extrabold leading-tight mb-5"><%= t.title || 'Software & IT Tenders via PPRA' %></h2>
                <p class="text-navy-200 leading-relaxed mb-8"><%= t.description %></p>
                <div class="flex flex-wrap gap-3">
                    <% if (t.cta_href) { %>
                    <a href="<%= t.cta_href %>" target="_blank" rel="noopener" class="btn-accent">
                        <%= t.cta_text || 'View Tenders on PPRA' %>
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                    </a>
                    <% } %>
                    <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-semibold text-white border border-white/25 hover:bg-white/10 transition">
                        Partner With Us
                    </a>
                </div>
                <% if (t.filter_hint) { %>
                <p class="mt-4 text-sm text-navy-300 flex items-start gap-2">
                    <svg class="w-4 h-4 text-blue-300 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    <span><%= t.filter_hint %></span>
                </p>
                <% } %>
            </div>
            <% if (t.points && t.points.length) { %>
            <div class="rounded-2xl bg-white/5 border border-white/10 p-8 backdrop-blur-sm">
                <ul class="space-y-5">
                    <% t.points.forEach(p => { %>
                    <li class="flex items-start gap-3">
                        <span class="w-7 h-7 rounded-full bg-blue-500/20 text-blue-300 flex items-center justify-center flex-shrink-0 mt-0.5">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                        </span>
                        <span class="text-navy-100 leading-relaxed"><%= p %></span>
                    </li>
                    <% }) %>
                </ul>
            </div>
            <% } %>
        </div>
    </section>

    <!-- Live / Recent Government Software Tenders (PPRA) -->
    <% if (t.listings && t.listings.length) { %>
    <section class="py-20 lg:py-24 bg-white/55 backdrop-blur-[2px]">
        <div class="max-w-7xl mx-auto px-6">
            <div class="text-center max-w-3xl mx-auto mb-12">
                <span class="premium-badge mb-3">PPRA Opportunities</span>
                <h2 class="font-display text-2xl md:text-3xl lg:text-4xl font-extrabold text-navy-900 mt-3 mb-4"><%= t.listings_title || 'Government Software & IT Tenders on PPRA' %></h2>
                <% if (t.listings_note) { %><p class="text-navy-600 leading-relaxed"><%= t.listings_note %></p><% } %>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <% t.listings.forEach(item => { %>
                <a href="<%= item.url || (t.live_href || 'https://ppra.gov.pk/') %>" target="_blank" rel="noopener" class="group rounded-2xl bg-white border border-navy-100 shadow-card hover:shadow-card-hover transition p-6 flex flex-col">
                    <div class="flex items-center gap-2 mb-3 flex-wrap">
                        <% if (item.category) { %>
                        <span class="inline-block px-2.5 py-1 rounded-full bg-blue-50 text-blue-700 border border-blue-100 text-xs font-semibold"><%= item.category %></span>
                        <% } %>
                        <% if (item.date) { %>
                        <span class="inline-flex items-center gap-1 text-xs font-medium text-navy-500">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                            <%= item.date %>
                        </span>
                        <% } %>
                    </div>
                    <h3 class="font-display text-lg font-extrabold text-navy-900 mb-2 group-hover:text-brand transition leading-snug"><%= item.title %></h3>
                    <% if (item.department) { %>
                    <p class="text-navy-700 text-sm flex items-start gap-2">
                        <svg class="w-4 h-4 text-blue-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0H5m14 0h2M5 21H3m4-14h2m-2 4h2m6-4h2m-2 4h2"/></svg>
                        <%= item.department %>
                    </p>
                    <% } %>
                    <div class="mt-4 pt-4 border-t border-navy-100 flex items-center justify-between text-sm">
                        <% if (item.ref) { %><span class="font-mono text-xs text-navy-500">Ref: <%= item.ref %></span><% } else { %><span></span><% } %>
                        <span class="inline-flex items-center gap-1 text-brand font-semibold">
                            View on PPRA
                            <svg class="w-4 h-4 transition group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                        </span>
                    </div>
                </a>
                <% }) %>
            </div>

            <div class="mt-10 text-center">
                <a href="<%= t.live_href || 'https://epms.ppra.gov.pk/public/tenders/active-tenders' %>" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-6 py-3.5 bg-brand text-white rounded-lg font-semibold hover:bg-navy-800 transition shadow-md">
                    <%= t.live_text || 'Browse Live Tenders on PPRA' %>
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                </a>
                <% if (t.filter_hint) { %>
                <p class="text-sm text-navy-600 mt-4 inline-flex items-start gap-2 text-left max-w-xl">
                    <svg class="w-4 h-4 text-brand flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    <span><%= t.filter_hint %></span>
                </p>
                <% } %>
                <p class="text-xs text-navy-500 mt-3">Source: Public Procurement Regulatory Authority (PPRA), Government of Pakistan — listings update daily.</p>
            </div>
        </div>
    </section>
    <% } %>

    <!-- CTA -->
    <section class="py-16 bg-navy-50">
        <div class="max-w-4xl mx-auto px-6 text-center">
            <h2 class="font-display text-2xl md:text-3xl font-extrabold text-navy-900 mb-3">Have a software requirement or tender?</h2>
            <p class="text-navy-700 mb-6">Talk to our IT team about your project, RFP or government tender — we will respond within one business day.</p>
            <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3.5 bg-brand text-white rounded-lg font-semibold hover:bg-navy-800 transition shadow-md">
                Contact Us
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
        </div>
    </section>

    <%- include('partials/footer') %>
</body>
</html>
