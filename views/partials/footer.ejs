<footer class="bg-navy-950 text-navy-300 relative">
    <div class="absolute top-0 left-0 right-0 h-[3px] bg-gradient-to-r from-transparent via-gold-500 to-transparent"></div>
    <div class="max-w-7xl mx-auto px-6 py-14 grid md:grid-cols-2 lg:grid-cols-4 gap-10">
        <div>
            <div class="font-display font-extrabold text-2xl text-white mb-4 tracking-tight"><%= content.site.name %></div>
            <p class="text-sm leading-relaxed"><%= content.footer.description %></p>
        </div>
        <% (content.footer.columns || []).forEach(col => { %>
        <div>
            <h4 class="text-white font-display font-bold mb-4"><%= col.title %></h4>
            <ul class="space-y-2 text-sm">
                <% (col.links || []).forEach(link => { %>
                <li><a href="<%= link.href %>" class="hover:text-white transition"><%= link.label %></a></li>
                <% }) %>
            </ul>
        </div>
        <% }) %>
        <div>
            <h4 class="text-white font-display font-bold mb-4">Get in Touch</h4>
            <ul class="space-y-3 text-sm">
                <% if (content.site.email) { %>
                <li class="flex items-start gap-2.5">
                    <svg class="w-4 h-4 text-blue-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    <%= content.site.email %>
                </li>
                <% } %>
                <% if (content.footer.address) { %>
                <li class="flex items-start gap-2.5">
                    <svg class="w-4 h-4 text-blue-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    <%= content.footer.address %>
                </li>
                <% } %>
                <% if (content.site.iso_certified) { %>
                <li class="flex items-start gap-2.5">
                    <svg class="w-4 h-4 text-blue-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                    ISO Certified
                </li>
                <% } %>
            </ul>
        </div>
    </div>
    <div class="border-t border-white/10">
        <div class="max-w-7xl mx-auto px-6 py-6 flex flex-col sm:flex-row justify-between items-center gap-3 text-sm">
            <p>&copy; <%= new Date().getFullYear() %> <%= content.footer.copyright %></p>
            <div class="flex items-center gap-4">
                <a href="/admin/login" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-white/5 hover:bg-white/10 text-navy-300 hover:text-white border border-white/10 hover:border-white/20 transition text-xs font-medium" title="Admin Login">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                    Admin
                </a>
                <p>Built by <a href="<%= content.footer.credit_link %>" target="_blank" rel="noopener" class="text-blue-400 hover:text-blue-300 transition"><%= content.footer.credit_name %></a></p>
            </div>
        </div>
    </div>
</footer>

<svg width="0" height="0" aria-hidden="true" style="position:absolute">
    <defs>
        <filter id="emeraldTint" color-interpolation-filters="sRGB">
            <feColorMatrix type="matrix" values="0 0 0 0 0.063  0 0 0 0 0.725  0 0 0 0 0.506  0 0 0 1 0"/>
        </filter>
    </defs>
</svg>

<script>
    const menuBtn = document.getElementById('menuBtn');
    const mobileMenu = document.getElementById('mobileMenu');
    if (menuBtn && mobileMenu) menuBtn.addEventListener('click', () => mobileMenu.classList.toggle('hidden'));

    document.querySelectorAll('#themeToggle').forEach(btn => {
        btn.addEventListener('click', () => {
            const isDark = document.documentElement.classList.toggle('dark');
            try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch (e) {}
        });
    });
</script>

<script>
    (function initBg3D() {
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (typeof THREE === 'undefined') { return setTimeout(initBg3D, 80); }

        const canvas = document.createElement('canvas');
        canvas.id = 'bg3d-canvas';
        document.body.prepend(canvas);

        const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.setSize(window.innerWidth, window.innerHeight);

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 100);
        camera.position.z = 6;

        // Circuit board: orthogonal traces with traveling electric pulses
        const isMobile = window.innerWidth < 768;
        const SPACING = 1.6;
        const GRID_X = isMobile ? 7 : 11;
        const GRID_Y = isMobile ? 5 : 7;

        const nodes = [];
        for (let xi = -GRID_X; xi <= GRID_X; xi++) {
            for (let yi = -GRID_Y; yi <= GRID_Y; yi++) {
                if (Math.random() > 0.6) {
                    nodes.push(new THREE.Vector3(
                        xi * SPACING + (Math.random() - 0.5) * 0.2,
                        yi * SPACING + (Math.random() - 0.5) * 0.2,
                        (Math.random() - 0.5) * 3
                    ));
                }
            }
        }

        const traces = [];
        const TRACE_COUNT = isMobile ? 35 : 70;
        for (let i = 0; i < TRACE_COUNT; i++) {
            const a = nodes[Math.floor(Math.random() * nodes.length)];
            let b;
            for (let tries = 0; tries < 5; tries++) {
                b = nodes[Math.floor(Math.random() * nodes.length)];
                const d = a.distanceTo(b);
                if (b !== a && d > 1.2 && d < 7) break;
            }
            if (!b || b === a) continue;
            const mid = new THREE.Vector3(a.x, b.y, (a.z + b.z) / 2);
            traces.push([a, mid, b]);
        }

        if (!traces.length) return;

        const linePoints = [];
        traces.forEach(([a, mid, b]) => {
            linePoints.push(a.x, a.y, a.z, mid.x, mid.y, mid.z);
            linePoints.push(mid.x, mid.y, mid.z, b.x, b.y, b.z);
        });
        const traceGeo = new THREE.BufferGeometry();
        traceGeo.setAttribute('position', new THREE.BufferAttribute(new Float32Array(linePoints), 3));
        const traceMat = new THREE.LineBasicMaterial({ transparent: true });
        const traceObj = new THREE.LineSegments(traceGeo, traceMat);
        scene.add(traceObj);

        const nodeArr = new Float32Array(nodes.length * 3);
        nodes.forEach((p, i) => { nodeArr[i*3] = p.x; nodeArr[i*3+1] = p.y; nodeArr[i*3+2] = p.z; });
        const nodeGeo = new THREE.BufferGeometry();
        nodeGeo.setAttribute('position', new THREE.BufferAttribute(nodeArr, 3));
        const nodeMat = new THREE.PointsMaterial({ size: 0.09, transparent: true, sizeAttenuation: true });
        const nodeObj = new THREE.Points(nodeGeo, nodeMat);
        scene.add(nodeObj);

        const PULSE_COUNT = isMobile ? 14 : 28;
        const pulses = [];
        for (let i = 0; i < PULSE_COUNT; i++) {
            pulses.push({
                traceIdx: Math.floor(Math.random() * traces.length),
                progress: Math.random(),
                speed: 0.003 + Math.random() * 0.008
            });
        }
        const pulsePos = new Float32Array(PULSE_COUNT * 3);
        const pulseGeo = new THREE.BufferGeometry();
        pulseGeo.setAttribute('position', new THREE.BufferAttribute(pulsePos, 3));
        const pulseMat = new THREE.PointsMaterial({ size: 0.22, transparent: true, sizeAttenuation: true });
        const pulseObj = new THREE.Points(pulseGeo, pulseMat);
        scene.add(pulseObj);

        function applyTheme() {
            const dark = document.documentElement.classList.contains('dark');
            if (dark) {
                traceMat.color.setHex(0x3b82f6); traceMat.opacity = 0.32;
                nodeMat.color.setHex(0x93c5fd);  nodeMat.opacity  = 0.55;
                pulseMat.color.setHex(0x34d399); pulseMat.opacity = 1.0;
            } else {
                traceMat.color.setHex(0x1e3a8a); traceMat.opacity = 0.22;
                nodeMat.color.setHex(0x1e3a8a);  nodeMat.opacity  = 0.45;
                pulseMat.color.setHex(0x10b981); pulseMat.opacity = 0.85;
            }
        }
        applyTheme();
        new MutationObserver(applyTheme).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

        let mx = 0, my = 0;
        window.addEventListener('pointermove', (e) => {
            mx = (e.clientX / window.innerWidth - 0.5) * 0.8;
            my = (e.clientY / window.innerHeight - 0.5) * 0.8;
        }, { passive: true });

        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });

        let running = true;
        document.addEventListener('visibilitychange', () => { running = !document.hidden; if (running) tick(); });

        let camX = 0, camY = 0;
        function tick() {
            if (!running) return;
            requestAnimationFrame(tick);

            for (let i = 0; i < pulses.length; i++) {
                const p = pulses[i];
                p.progress += p.speed;
                if (p.progress > 1) {
                    p.progress = 0;
                    p.traceIdx = Math.floor(Math.random() * traces.length);
                    p.speed = 0.003 + Math.random() * 0.008;
                }
                const [a, mid, b] = traces[p.traceIdx];
                let x, y, z;
                if (p.progress < 0.5) {
                    const t = p.progress * 2;
                    x = a.x + (mid.x - a.x) * t;
                    y = a.y + (mid.y - a.y) * t;
                    z = a.z + (mid.z - a.z) * t;
                } else {
                    const t = (p.progress - 0.5) * 2;
                    x = mid.x + (b.x - mid.x) * t;
                    y = mid.y + (b.y - mid.y) * t;
                    z = mid.z + (b.z - mid.z) * t;
                }
                pulsePos[i*3] = x; pulsePos[i*3+1] = y; pulsePos[i*3+2] = z;
            }
            pulseGeo.attributes.position.needsUpdate = true;

            traceObj.rotation.z = Math.sin(Date.now() * 0.00008) * 0.04;

            camX += (mx - camX) * 0.04;
            camY += (-my - camY) * 0.04;
            camera.position.x = camX;
            camera.position.y = camY;
            camera.lookAt(0, 0, 0);
            renderer.render(scene, camera);
        }
        tick();
    })();
</script>
