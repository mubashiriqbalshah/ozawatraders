<footer class="bg-navy-950 text-navy-300 relative">
    <div class="absolute top-0 left-0 right-0 h-[3px] bg-gradient-to-r from-transparent via-gold-500 to-transparent"></div>
    <div class="max-w-7xl mx-auto px-6 py-14 grid md:grid-cols-2 lg:grid-cols-4 gap-10">
        <div>
            <div class="font-display font-extrabold text-2xl text-white mb-4 tracking-tight"><%= content.site.name %></div>
            <p class="text-sm leading-relaxed"><%= content.footer.description %></p>
        </div>
        <% (content.footer.columns || []).forEach(col => { %>
        <div>
            <h4 class="text-white font-display font-bold mb-4"><%= col.title %></h4>
            <ul class="space-y-2 text-sm">
                <% (col.links || []).forEach(link => { %>
                <li><a href="<%= link.href %>" class="hover:text-white transition"><%= link.label %></a></li>
                <% }) %>
            </ul>
        </div>
        <% }) %>
        <div>
            <h4 class="text-white font-display font-bold mb-4">Get in Touch</h4>
            <ul class="space-y-3 text-sm">
                <% if (content.site.email) { %>
                <li class="flex items-start gap-2.5">
                    <svg class="w-4 h-4 text-blue-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    <%= content.site.email %>
                </li>
                <% } %>
                <% if (content.footer.address) { %>
                <li class="flex items-start gap-2.5">
                    <svg class="w-4 h-4 text-blue-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    <%= content.footer.address %>
                </li>
                <% } %>
                <% if (content.site.iso_certified) { %>
                <li class="flex items-start gap-2.5">
                    <svg class="w-4 h-4 text-blue-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                    ISO Certified
                </li>
                <% } %>
            </ul>
        </div>
    </div>
    <div class="border-t border-white/10">
        <div class="max-w-7xl mx-auto px-6 py-6 flex flex-col sm:flex-row justify-between items-center gap-3 text-sm">
            <p>&copy; <%= new Date().getFullYear() %> <%= content.footer.copyright %></p>
            <div class="flex items-center gap-4">
                <a href="/admin/login" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-white/5 hover:bg-white/10 text-navy-300 hover:text-white border border-white/10 hover:border-white/20 transition text-xs font-medium" title="Admin Login">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                    Admin
                </a>
                <p>Built by <a href="<%= content.footer.credit_link %>" target="_blank" rel="noopener" class="text-blue-400 hover:text-blue-300 transition"><%= content.footer.credit_name %></a></p>
            </div>
        </div>
    </div>
</footer>

<svg width="0" height="0" aria-hidden="true" style="position:absolute">
    <defs>
        <filter id="emeraldTint" color-interpolation-filters="sRGB">
            <feColorMatrix type="matrix" values="0 0 0 0 0.063  0 0 0 0 0.725  0 0 0 0 0.506  0 0 0 1 0"/>
        </filter>
    </defs>
</svg>

<script>
    const menuBtn = document.getElementById('menuBtn');
    const mobileMenu = document.getElementById('mobileMenu');
    if (menuBtn && mobileMenu) menuBtn.addEventListener('click', () => mobileMenu.classList.toggle('hidden'));

    document.querySelectorAll('#themeToggle').forEach(btn => {
        btn.addEventListener('click', () => {
            const isDark = document.documentElement.classList.toggle('dark');
            try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch (e) {}
        });
    });
</script>

