<style>
    .lightbox-gallery img { cursor: zoom-in; }
    #lightbox-overlay {
        position: fixed; inset: 0; z-index: 100;
        background: rgba(10, 20, 43, 0.92);
        backdrop-filter: blur(8px);
        display: none;
        align-items: center; justify-content: center;
        padding: 2rem;
        animation: lb-fade 0.2s ease-out;
        overflow: hidden;
    }
    #lightbox-overlay.open { display: flex; }
    @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
    #lightbox-frame {
        width: fit-content;
        max-width: 95vw;
        max-height: 90vh;
        overflow: hidden;
        border-radius: 1rem;
        box-shadow: 0 20px 60px rgba(0,0,0,0.5);
        background: #0a142b;
        animation: lb-scale 0.25s cubic-bezier(0.4,0,0.2,1);
        line-height: 0;
    }
    @keyframes lb-scale { from { transform: scale(0.92); opacity: 0; } to { transform: scale(1); opacity: 1; } }
    #lightbox-img {
        display: block;
        max-width: 95vw;
        max-height: 90vh;
        object-fit: contain;
        transition: transform 0.2s ease;
        will-change: transform;
        user-select: none;
        -webkit-user-drag: none;
        -webkit-user-select: none;
        cursor: grab;
    }
    #lightbox-img.dragging { transition: none; cursor: grabbing; }
    .lb-btn {
        position: absolute;
        background: rgba(255,255,255,0.1);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,0.2);
        color: white;
        width: 48px; height: 48px;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
    }
    .lb-btn:hover { background: rgba(255,255,255,0.2); transform: scale(1.05); }
    .lb-close { top: 1.5rem; right: 1.5rem; }
    .lb-prev { left: 1.5rem; top: 50%; transform: translateY(-50%); }
    .lb-next { right: 1.5rem; top: 50%; transform: translateY(-50%); }
    .lb-prev:hover, .lb-next:hover { transform: translateY(-50%) scale(1.05); }
    .lb-counter { position: absolute; bottom: 1.5rem; left: 50%; transform: translateX(-50%); color: rgba(255,255,255,0.7); font-size: 0.875rem; font-weight: 500; }
    .lb-zoom-controls {
        position: absolute;
        bottom: 1.5rem; right: 1.5rem;
        display: flex; flex-direction: column; gap: 0.5rem;
        z-index: 2;
    }
    .lb-zoom-btn {
        background: rgba(255,255,255,0.1);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,0.2);
        color: white;
        width: 40px; height: 40px;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
        font-size: 18px; font-weight: 700; line-height: 1;
        font-family: inherit;
    }
    .lb-zoom-btn:hover { background: rgba(255,255,255,0.2); }
</style>

<div id="lightbox-overlay" role="dialog" aria-modal="true" aria-label="Image preview">
    <button type="button" class="lb-btn lb-close" aria-label="Close">
        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
    <button type="button" class="lb-btn lb-prev" aria-label="Previous">
        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
    </button>
    <button type="button" class="lb-btn lb-next" aria-label="Next">
        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
    </button>
    <div id="lightbox-frame">
        <img id="lightbox-img" src="" alt="" draggable="false">
    </div>
    <div class="lb-counter"></div>
    <div class="lb-zoom-controls">
        <button type="button" class="lb-zoom-btn lb-zoom-in" aria-label="Zoom in" title="Zoom in">+</button>
        <button type="button" class="lb-zoom-btn lb-zoom-out" aria-label="Zoom out" title="Zoom out">&minus;</button>
        <button type="button" class="lb-zoom-btn lb-zoom-reset" aria-label="Reset zoom" title="Reset">&#8634;</button>
    </div>
</div>

<script>
(function() {
    const overlay = document.getElementById('lightbox-overlay');
    if (!overlay) return;
    const imgEl = document.getElementById('lightbox-img');
    const counter = overlay.querySelector('.lb-counter');
    const btnClose = overlay.querySelector('.lb-close');
    const btnPrev = overlay.querySelector('.lb-prev');
    const btnNext = overlay.querySelector('.lb-next');
    const btnZoomIn = overlay.querySelector('.lb-zoom-in');
    const btnZoomOut = overlay.querySelector('.lb-zoom-out');
    const btnZoomReset = overlay.querySelector('.lb-zoom-reset');

    const DEFAULT_SCALE = 2;
    let images = [];
    let index = 0;
    let scale = 1, tx = 0, ty = 0;
    let dragging = false, startX = 0, startY = 0, startTx = 0, startTy = 0;

    function clampPan() {
        const W = imgEl.clientWidth;
        const H = imgEl.clientHeight;
        const maxX = Math.max(0, W * (scale - 1) / 2);
        const maxY = Math.max(0, H * (scale - 1) / 2);
        tx = Math.max(-maxX, Math.min(maxX, tx));
        ty = Math.max(-maxY, Math.min(maxY, ty));
    }

    function applyTransform() {
        clampPan();
        imgEl.style.transform = 'translate(' + tx + 'px, ' + ty + 'px) scale(' + scale + ')';
    }

    function resetZoom() {
        scale = 1; tx = 0; ty = 0;
        imgEl.style.transform = '';
        imgEl.classList.remove('dragging');
    }

    function zoomBy(factor) {
        const next = Math.max(1, Math.min(5, scale * factor));
        if (next === scale) return;
        scale = next;
        if (scale === 1) { tx = 0; ty = 0; }
        applyTransform();
    }

    function show(i) {
        if (!images.length) return;
        index = (i + images.length) % images.length;
        scale = 1; tx = 0; ty = 0;
        imgEl.style.transform = '';
        imgEl.src = images[index];
        counter.textContent = (index + 1) + ' / ' + images.length;
        const multi = images.length > 1;
        btnPrev.style.display = multi ? '' : 'none';
        btnNext.style.display = multi ? '' : 'none';
    }

    function open(i) {
        show(i);
        overlay.classList.add('open');
        document.body.style.overflow = 'hidden';
    }

    function close() {
        overlay.classList.remove('open');
        document.body.style.overflow = '';
        resetZoom();
    }

    imgEl.addEventListener('load', () => {
        scale = DEFAULT_SCALE; tx = 0; ty = 0;
        applyTransform();
    });

    document.querySelectorAll('.lightbox-gallery').forEach(gallery => {
        const items = Array.from(gallery.querySelectorAll('img'));
        items.forEach((img, i) => {
            img.addEventListener('click', () => {
                images = items.map(x => x.dataset.full || x.src);
                open(i);
            });
        });
    });

    btnClose.addEventListener('click', close);
    btnPrev.addEventListener('click', e => { e.stopPropagation(); show(index - 1); });
    btnNext.addEventListener('click', e => { e.stopPropagation(); show(index + 1); });
    btnZoomIn.addEventListener('click', e => { e.stopPropagation(); zoomBy(1.4); });
    btnZoomOut.addEventListener('click', e => { e.stopPropagation(); zoomBy(1 / 1.4); });
    btnZoomReset.addEventListener('click', e => { e.stopPropagation(); resetZoom(); });

    overlay.addEventListener('click', e => { if (e.target === overlay) close(); });
    document.addEventListener('keydown', e => {
        if (!overlay.classList.contains('open')) return;
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowLeft') show(index - 1);
        else if (e.key === 'ArrowRight') show(index + 1);
        else if (e.key === '+' || e.key === '=') zoomBy(1.4);
        else if (e.key === '-' || e.key === '_') zoomBy(1 / 1.4);
        else if (e.key === '0') resetZoom();
    });

    imgEl.addEventListener('wheel', e => {
        e.preventDefault();
        zoomBy(e.deltaY < 0 ? 1.15 : 1 / 1.15);
    }, { passive: false });

    imgEl.addEventListener('dblclick', () => {
        if (scale === 1) { scale = 2; applyTransform(); }
        else { resetZoom(); }
    });

    imgEl.addEventListener('mousedown', e => {
        e.preventDefault();
        dragging = true;
        startX = e.clientX; startY = e.clientY;
        startTx = tx; startTy = ty;
        imgEl.classList.add('dragging');
    });
    window.addEventListener('mousemove', e => {
        if (!dragging) return;
        tx = startTx + (e.clientX - startX);
        ty = startTy + (e.clientY - startY);
        applyTransform();
    });
    window.addEventListener('mouseup', () => {
        if (!dragging) return;
        dragging = false;
        imgEl.classList.remove('dragging');
    });

    imgEl.addEventListener('dragstart', e => e.preventDefault());

    let touchX = null;
    overlay.addEventListener('touchstart', e => { touchX = e.changedTouches[0].clientX; }, { passive: true });
    overlay.addEventListener('touchend', e => {
        if (touchX === null) return;
        const dx = e.changedTouches[0].clientX - touchX;
        if (Math.abs(dx) > 50 && scale === 1) show(index + (dx < 0 ? 1 : -1));
        touchX = null;
    }, { passive: true });
})();
</script>
