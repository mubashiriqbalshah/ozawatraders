<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="X-UA-Compatible" content="ie=edge">
<meta name="description" content="<%= content.site.meta_description || 'Ozawa Traders Pvt Ltd — Leading Industrial, Power & Medical Solution Provider in Pakistan with 20+ years of experience.' %>">
<meta name="keywords" content="<%= content.site.meta_keywords || 'Ozawa Traders, Industrial solutions, Power, Medical equipment, Radiology, Cardiology, Physiotherapy, Ambulances, Pakistan' %>">
<title><%= typeof pageTitle !== 'undefined' ? pageTitle : (content.site.name + ' — ' + (content.site.meta_subtitle || 'Industrial, Power & Medical Solutions')) %></title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">

<script>
    (function () {
        try {
            var t = localStorage.getItem('theme');
            if (t === 'dark' || (!t && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
            }
        } catch (e) {}
    })();
</script>
<script src="https://cdn.tailwindcss.com"></script>
<script defer src="https://unpkg.com/three@0.160.0/build/three.min.js"></script>
<script>
    tailwind.config = {
        darkMode: 'class',
        theme: {
            extend: {
                colors: {
                    navy: { 50:'#f0f4fa',100:'#dae4f1',200:'#b6c9e3',300:'#8aa7cf',400:'#5d82b6',500:'#3f649b',600:'#2f4f7e',700:'#264166',800:'#1a2f4a',900:'#0f1d33',950:'#0a142b' },
                    brand: { DEFAULT: '#1e3a8a', light: '#3b82f6', dark: '#0f1d33' },
                    gold: { 50:'#ecfdf5',100:'#d1fae5',200:'#a7f3d0',300:'#6ee7b7',400:'#34d399',500:'#10b981',600:'#059669',700:'#047857',800:'#065f46',900:'#064e3b',950:'#022c22' },
                    accent: { DEFAULT: '#10b981', light: '#34d399', dark: '#047857' }
                },
                fontFamily: {
                    sans: ['Inter','system-ui','sans-serif'],
                    display: ['Plus Jakarta Sans','Inter','sans-serif']
                },
                boxShadow: {
                    'card': '0 4px 24px -8px rgba(15, 29, 51, 0.12)',
                    'card-hover': '0 16px 40px -12px rgba(15, 29, 51, 0.25)',
                    'accent': '0 4px 14px -2px rgba(16, 185, 129, 0.35)'
                }
            }
        }
    }
</script>
<style>
    html { scroll-behavior: smooth; }
    body {
        font-family: 'Inter', system-ui, sans-serif;
        background:
            radial-gradient(ellipse 80% 60% at 20% 0%, rgba(59, 130, 246, 0.06) 0%, transparent 50%),
            radial-gradient(ellipse 80% 60% at 80% 100%, rgba(16, 185, 129, 0.05) 0%, transparent 50%),
            radial-gradient(ellipse 60% 50% at 50% 50%, rgba(30, 58, 138, 0.03) 0%, transparent 50%),
            linear-gradient(180deg, #fafbfc 0%, #f3f6fb 100%);
        background-attachment: fixed;
        position: relative;
        min-height: 100vh;
    }
    body::before {
        content: '';
        position: fixed;
        inset: 0;
        background-image:
            linear-gradient(rgba(30, 58, 138, 0.025) 1px, transparent 1px),
            linear-gradient(90deg, rgba(30, 58, 138, 0.025) 1px, transparent 1px);
        background-size: 56px 56px;
        background-position: center center;
        pointer-events: none;
        z-index: 0;
        mask-image: radial-gradient(ellipse 90% 80% at 50% 50%, black 30%, transparent 80%);
        -webkit-mask-image: radial-gradient(ellipse 90% 80% at 50% 50%, black 30%, transparent 80%);
    }
    body::after {
        content: '';
        position: fixed;
        top: -20%;
        left: -20%;
        width: 140%;
        height: 140%;
        background:
            radial-gradient(circle 500px at 15% 20%, rgba(59, 130, 246, 0.65), transparent 60%),
            radial-gradient(circle 450px at 85% 30%, rgba(16, 185, 129, 0.55), transparent 60%),
            radial-gradient(circle 600px at 50% 75%, rgba(30, 58, 138, 0.50), transparent 60%),
            radial-gradient(circle 400px at 90% 90%, rgba(59, 130, 246, 0.55), transparent 60%),
            radial-gradient(circle 350px at 5% 85%, rgba(16, 185, 129, 0.45), transparent 60%);
        pointer-events: none;
        z-index: 0;
        animation: meshDrift 16s ease-in-out infinite alternate;
        filter: blur(60px);
        will-change: transform;
    }
    @keyframes meshDrift {
        0%   { transform: translate(0, 0) scale(1); }
        25%  { transform: translate(8%, -6%) scale(1.08); }
        50%  { transform: translate(-7%, 8%) scale(1.12); }
        75%  { transform: translate(6%, 7%) scale(0.95); }
        100% { transform: translate(-8%, -5%) scale(1.05); }
    }
    body > * { position: relative; z-index: 1; }
    @media (prefers-reduced-motion: reduce) {
        body::after { animation: none; }
        header::before { animation: none !important; }
    }
    /* Header shimmer animation - subtle gold light sweep */
    header { position: relative; isolation: isolate; }
    header::before {
        content: '';
        position: absolute;
        inset: 0;
        background:
            linear-gradient(110deg,
                transparent 30%,
                rgba(16, 185, 129, 0.14) 45%,
                rgba(52, 211, 153, 0.18) 50%,
                rgba(16, 185, 129, 0.14) 55%,
                transparent 70%
            );
        background-size: 250% 100%;
        background-position: 200% 0%;
        animation: headerShimmer 7s ease-in-out infinite;
        pointer-events: none;
        z-index: -1;
        mix-blend-mode: multiply;
    }
    header::after {
        content: '';
        position: absolute;
        left: 0; right: 0; bottom: 0;
        height: 2px;
        background: linear-gradient(90deg,
            transparent 0%,
            rgba(16, 185, 129, 0.3) 25%,
            rgba(52, 211, 153, 0.5) 50%,
            rgba(16, 185, 129, 0.3) 75%,
            transparent 100%
        );
        background-size: 200% 100%;
        animation: headerBottomLine 5s linear infinite;
        pointer-events: none;
    }
    @keyframes headerShimmer {
        0%   { background-position: 200% 0%; }
        50%  { background-position: -100% 0%; }
        100% { background-position: 200% 0%; }
    }
    @keyframes headerBottomLine {
        0%   { background-position: 0% 0%; }
        100% { background-position: 200% 0%; }
    }
    /* Dark navy sections - flowing signal/ECG waveform (industrial + medical theme) */
    /* Excluded: .no-bg-anim (e.g. hero banner slider) */
    section.bg-navy-950:not(.no-bg-anim), footer.bg-navy-950:not(.no-bg-anim) {
        position: relative;
        overflow: hidden;
    }
    /* Content above waveforms */
    section.bg-navy-950:not(.no-bg-anim) > *, footer.bg-navy-950:not(.no-bg-anim) > * {
        position: relative;
        z-index: 2;
    }
    section.bg-navy-950:not(.no-bg-anim)::before, footer.bg-navy-950:not(.no-bg-anim)::before {
        content: '';
        position: absolute;
        inset: -10%;
        background:
            radial-gradient(ellipse 720px 220px at 15% 30%, rgba(59, 130, 246, 0.30), transparent 60%),
            radial-gradient(ellipse 600px 180px at 85% 70%, rgba(16, 185, 129, 0.22), transparent 60%),
            radial-gradient(ellipse 500px 160px at 50% 50%, rgba(99, 102, 241, 0.20), transparent 60%);
        filter: blur(50px);
        animation: auroraDrift 22s ease-in-out infinite alternate;
        pointer-events: none;
        z-index: 0;
        will-change: transform;
    }
    section.bg-navy-950:not(.no-bg-anim)::after, footer.bg-navy-950:not(.no-bg-anim)::after {
        content: '';
        position: absolute;
        inset: -10%;
        background:
            radial-gradient(ellipse 520px 140px at 70% 20%, rgba(147, 197, 253, 0.22), transparent 60%),
            radial-gradient(ellipse 460px 130px at 25% 80%, rgba(52, 211, 153, 0.20), transparent 60%),
            radial-gradient(ellipse 380px 110px at 90% 50%, rgba(59, 130, 246, 0.18), transparent 60%);
        filter: blur(60px);
        animation: auroraDrift2 30s ease-in-out infinite alternate;
        pointer-events: none;
        z-index: 0;
        mix-blend-mode: screen;
        will-change: transform;
    }
    @keyframes auroraDrift {
        0%   { transform: translate(0, 0) scale(1) rotate(0deg); }
        50%  { transform: translate(4%, -3%) scale(1.12) rotate(1.5deg); }
        100% { transform: translate(-3%, 4%) scale(1.08) rotate(-1.5deg); }
    }
    @keyframes auroraDrift2 {
        0%   { transform: translate(0, 0) scale(1) rotate(0deg); }
        50%  { transform: translate(-5%, 3%) scale(1.15) rotate(-2deg); }
        100% { transform: translate(4%, -2%) scale(1.05) rotate(2deg); }
    }
    @media (prefers-reduced-motion: reduce) {
        section.bg-navy-950:not(.no-bg-anim)::before, footer.bg-navy-950:not(.no-bg-anim)::before,
        section.bg-navy-950:not(.no-bg-anim)::after, footer.bg-navy-950:not(.no-bg-anim)::after { animation: none; }
    }
    .font-display { font-family: 'Plus Jakarta Sans', 'Inter', sans-serif; }
    .hero-bg {
        background:
            radial-gradient(ellipse at top right, rgba(59, 130, 246, 0.18), transparent 50%),
            radial-gradient(ellipse at bottom left, rgba(16, 185, 129, 0.10), transparent 55%),
            radial-gradient(ellipse at top left, rgba(30, 58, 138, 0.25), transparent 50%),
            linear-gradient(135deg, #0a142b 0%, #0f1d33 50%, #1a2f4a 100%);
    }
    .btn-accent {
        display: inline-flex; align-items: center; gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        background: linear-gradient(135deg, #34d399 0%, #10b981 100%);
        color: white; font-weight: 600;
        border-radius: 0.625rem;
        box-shadow: 0 4px 14px -2px rgba(16, 185, 129, 0.45);
        transition: all 0.25s ease;
    }
    .btn-accent:hover { transform: translateY(-1px); box-shadow: 0 8px 20px -4px rgba(16, 185, 129, 0.55); }
    .premium-badge {
        display: inline-flex; align-items: center; gap: 0.375rem;
        padding: 0.25rem 0.75rem;
        background: linear-gradient(135deg, rgba(52, 211, 153, 0.15) 0%, rgba(16, 185, 129, 0.12) 100%);
        color: #047857;
        border: 1px solid rgba(16, 185, 129, 0.3);
        border-radius: 9999px;
        font-size: 0.75rem; font-weight: 700;
        letter-spacing: 0.05em; text-transform: uppercase;
    }
    .premium-badge svg { width: 0.875rem; height: 0.875rem; color: #10b981; }
    .accent-divider {
        height: 3px; width: 60px;
        background: linear-gradient(90deg, #10b981 0%, #34d399 100%);
        border-radius: 2px;
    }
    .hero-grid {
        background-image:
            linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px);
        background-size: 48px 48px;
        animation: gridDrift 60s linear infinite;
    }
    @keyframes gridDrift {
        from { background-position: 0 0; }
        to   { background-position: 48px 48px; }
    }
    .hero-bg { position: relative; overflow: hidden; }
    .hero-bg::after {
        content: '';
        position: absolute;
        inset: 0;
        background:
            linear-gradient(110deg,
                transparent 35%,
                rgba(16, 185, 129, 0.08) 47%,
                rgba(52, 211, 153, 0.14) 50%,
                rgba(16, 185, 129, 0.08) 53%,
                transparent 65%);
        background-size: 250% 100%;
        background-position: 200% 0%;
        animation: heroScan 9s ease-in-out infinite;
        pointer-events: none;
        z-index: 0;
        mix-blend-mode: screen;
    }
    .hero-bg::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 600 200' fill='none' stroke='%2360a5fa' stroke-width='0.6' stroke-opacity='0.35'><path d='M0 50 L120 50 L130 60 L260 60 L270 50 L600 50'/><path d='M0 150 L80 150 L90 140 L300 140 L310 150 L600 150'/><circle cx='130' cy='60' r='3' fill='%23d99517' fill-opacity='0.7' stroke='none'><animate attributeName='cx' values='130;600;130' dur='8s' repeatCount='indefinite'/></circle><circle cx='90' cy='140' r='3' fill='%23d99517' fill-opacity='0.7' stroke='none'><animate attributeName='cx' values='90;600;90' dur='11s' repeatCount='indefinite'/></circle></svg>");
        background-repeat: repeat;
        background-size: 600px 200px;
        opacity: 0.5;
        pointer-events: none;
        z-index: 0;
        mask-image: linear-gradient(180deg, transparent 0%, black 30%, black 70%, transparent 100%);
        -webkit-mask-image: linear-gradient(180deg, transparent 0%, black 30%, black 70%, transparent 100%);
    }
    .hero-bg > * { position: relative; z-index: 1; }
    @keyframes heroScan {
        0%   { background-position: 200% 0%; }
        50%  { background-position: -100% 0%; }
        100% { background-position: 200% 0%; }
    }
    @media (prefers-reduced-motion: reduce) {
        .hero-grid, .hero-bg::after { animation: none; }
    }
    .hero-watermark {
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        pointer-events: none;
        padding-top: 1.5rem;
    }
    .hero-watermark img {
        width: auto;
        height: 56px;
        max-width: 70%;
        opacity: 0.2;
        filter: brightness(0) invert(1);
        object-fit: contain;
    }
    @media (min-width: 768px) {
        .hero-watermark img { height: 76px; opacity: 0.22; }
    }
    @media (min-width: 1024px) {
        .hero-watermark img { height: 96px; opacity: 0.25; }
    }
    .gradient-text {
        background: linear-gradient(135deg, #60a5fa 0%, #93c5fd 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }
    .product-card { transition: all 0.3s cubic-bezier(0.4,0,0.2,1); }
    .product-card:hover { transform: translateY(-4px); }
    .product-card .icon-wrap { transition: all 0.3s ease; }
    .product-card:hover .icon-wrap { background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%); }
    .product-card:hover .icon-wrap img { filter: brightness(0) invert(1); }
    .nav-link {
        position: relative;
        padding: 0.5rem 0.25rem;
        letter-spacing: 0.01em;
        transition: color 0.25s ease;
    }
    .nav-link::before {
        content: '';
        position: absolute;
        left: 50%; right: 50%;
        bottom: -2px;
        height: 3px;
        background: linear-gradient(90deg, #10b981 0%, #34d399 50%, #10b981 100%);
        border-radius: 2px;
        transition: left 0.35s cubic-bezier(0.4, 0, 0.2, 1), right 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.25s ease;
        opacity: 0;
    }
    .nav-link:hover::before,
    .nav-link.active::before {
        left: 0; right: 0;
        opacity: 1;
    }
    .nav-link::after {
        content: '';
        position: absolute;
        left: 0; right: 0; top: -6px; bottom: -6px;
        background: linear-gradient(180deg, rgba(16, 185, 129, 0.06) 0%, transparent 100%);
        border-radius: 0.5rem;
        opacity: 0;
        transition: opacity 0.25s ease;
        z-index: -1;
    }
    .nav-link:hover::after { opacity: 1; }
    .nav-link.active { color: #1e3a8a !important; font-weight: 700; }
    .nav-link:hover { color: #0f1d33; }
    @keyframes fade-up { from { opacity:0; transform: translateY(20px); } to { opacity:1; transform: translateY(0); } }
    .fade-up { animation: fade-up 0.7s ease-out both; }
    .hero-slide {
        position: absolute; inset: 0;
        background-size: cover;
        background-position: center;
        opacity: 0;
        transition: opacity 1.2s ease-in-out;
    }
    .hero-slide.active { opacity: 1; }
    .hero-dot { width: 0.5rem; height: 0.5rem; border-radius: 9999px; background: rgba(255,255,255,0.4); transition: all 0.3s ease; cursor: pointer; }
    .hero-dot:hover { background: rgba(255,255,255,0.7); }
    .hero-dot.active { background: white; width: 1.5rem; }

    /* ---------------- Three.js 3D background canvas ---------------- */
    #bg3d-canvas {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        pointer-events: none;
        opacity: 0.85;
    }
    @media (max-width: 640px) {
        #bg3d-canvas { opacity: 0.5; }
    }

    /* ---------------- Dark mode overrides ---------------- */
    html.dark { color-scheme: dark; }
    html.dark body {
        color: #e5e7eb;
        background: #05101f !important;
        background-attachment: fixed;
    }
    html.dark body::before {
        background-image:
            linear-gradient(rgba(147, 197, 253, 0.025) 1px, transparent 1px),
            linear-gradient(90deg, rgba(147, 197, 253, 0.025) 1px, transparent 1px);
    }
    html.dark body::after {
        opacity: 0.18;
        filter: blur(100px);
        background:
            radial-gradient(circle 500px at 15% 20%, rgba(30, 58, 138, 0.55), transparent 60%),
            radial-gradient(circle 450px at 85% 30%, rgba(15, 29, 51, 0.55), transparent 60%),
            radial-gradient(circle 600px at 50% 75%, rgba(30, 58, 138, 0.50), transparent 60%),
            radial-gradient(circle 400px at 90% 90%, rgba(15, 29, 51, 0.55), transparent 60%),
            radial-gradient(circle 350px at 5% 85%, rgba(30, 58, 138, 0.45), transparent 60%);
    }
    html.dark header.sticky { background-color: rgba(5, 16, 31, 0.92) !important; border-color: rgba(255,255,255,0.06) !important; }
    html.dark header::before { mix-blend-mode: screen; }
    html.dark header img { filter: brightness(0) invert(1); }
