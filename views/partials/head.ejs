<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="X-UA-Compatible" content="ie=edge">
<meta name="description" content="<%= content.site.meta_description || 'Ozawa Traders Pvt Ltd — Leading Industrial, Power & Medical Solution Provider in Pakistan with 20+ years of experience.' %>">
<meta name="keywords" content="<%= content.site.meta_keywords || 'Ozawa Traders, Industrial solutions, Power, Medical equipment, Radiology, Cardiology, Physiotherapy, Ambulances, Pakistan' %>">
<title><%= typeof pageTitle !== 'undefined' ? pageTitle : (content.site.name + ' — ' + (content.site.meta_subtitle || 'Industrial, Power & Medical Solutions')) %></title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@600;700;800&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">

<script>
    (function () {
        try {
            var t = localStorage.getItem('theme');
            if (t === 'dark' || (!t && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
            }
        } catch (e) {}
    })();
</script>
<script src="https://cdn.tailwindcss.com"></script>
<script>
    tailwind.config = {
        darkMode: 'class',
        theme: {
            extend: {
                colors: {
                    navy: { 50:'#f0f4fa',100:'#dae4f1',200:'#b6c9e3',300:'#8aa7cf',400:'#5d82b6',500:'#3f649b',600:'#2f4f7e',700:'#264166',800:'#1a2f4a',900:'#0f1d33',950:'#0a142b' },
                    brand: { DEFAULT: '#04a6e1', light: '#38c2ed', dark: '#0277b3' },
                    gold: { 50:'#e6f7fd',100:'#c4ecf9',200:'#8fd9f3',300:'#5ac6ed',400:'#2eb3e6',500:'#04a6e1',600:'#0388b9',700:'#026a90',800:'#024d68',900:'#012f40',950:'#001a24' },
                    accent: { DEFAULT: '#04a6e1', light: '#38c2ed', dark: '#0277b3' }
                },
                fontFamily: {
                    sans: ['Inter','system-ui','sans-serif'],
                    display: ['Plus Jakarta Sans','Inter','sans-serif']
                },
                boxShadow: {
                    'card': '0 4px 24px -8px rgba(34, 34, 34, 0.10)',
                    'card-hover': '0 16px 40px -12px rgba(34, 34, 34, 0.20)',
                    'accent': '0 4px 14px -2px rgba(4, 166, 225, 0.35)'
                }
            }
        }
    }
</script>
<style>
    html { scroll-behavior: smooth; }
    body {
        font-family: 'Inter', system-ui, sans-serif;
        color: #333333;
        background:
            radial-gradient(ellipse 80% 60% at 20% 0%, rgba(4, 166, 225, 0.05) 0%, transparent 50%),
            radial-gradient(ellipse 80% 60% at 80% 100%, rgba(4, 166, 225, 0.04) 0%, transparent 50%),
            linear-gradient(180deg, #ffffff 0%, #f6f6f6 100%);
        background-attachment: fixed;
        position: relative;
        min-height: 100vh;
    }
    body::before {
        content: '';
        position: fixed;
        inset: 0;
        background-image:
            linear-gradient(rgba(34, 34, 34, 0.025) 1px, transparent 1px),
            linear-gradient(90deg, rgba(34, 34, 34, 0.025) 1px, transparent 1px);
        background-size: 56px 56px;
        background-position: center center;
        pointer-events: none;
        z-index: 0;
        mask-image: radial-gradient(ellipse 90% 80% at 50% 50%, black 30%, transparent 80%);
        -webkit-mask-image: radial-gradient(ellipse 90% 80% at 50% 50%, black 30%, transparent 80%);
    }
    body > * { position: relative; z-index: 1; }
    /* Header shimmer animation - subtle gold light sweep */
    header { position: relative; isolation: isolate; }
    header::before {
        content: '';
        position: absolute;
        inset: 0;
        background:
            linear-gradient(110deg,
                transparent 30%,
                rgba(4, 166, 225, 0.10) 45%,
                rgba(56, 194, 237, 0.14) 50%,
                rgba(4, 166, 225, 0.10) 55%,
                transparent 70%
            );
        background-size: 250% 100%;
        background-position: 50% 0%;
        pointer-events: none;
        z-index: -1;
        mix-blend-mode: multiply;
    }
    header::after {
        content: '';
        position: absolute;
        left: 0; right: 0; bottom: 0;
        height: 2px;
        background: linear-gradient(90deg,
            transparent 0%,
            rgba(4, 166, 225, 0.3) 25%,
            rgba(56, 194, 237, 0.55) 50%,
            rgba(4, 166, 225, 0.3) 75%,
            transparent 100%
        );
        pointer-events: none;
    }
    /* Dark navy sections - solid, no glow */
    section.bg-navy-950, footer.bg-navy-950 {
        position: relative;
    }
    .font-display { font-family: 'Plus Jakarta Sans', 'Inter', sans-serif; }
    .hero-bg {
        background:
            radial-gradient(ellipse at top right, rgba(4, 166, 225, 0.22), transparent 50%),
            radial-gradient(ellipse at bottom left, rgba(56, 194, 237, 0.12), transparent 55%),
            radial-gradient(ellipse at top left, rgba(2, 119, 179, 0.25), transparent 50%),
            linear-gradient(135deg, #0a142b 0%, #0f1d33 50%, #1a2f4a 100%);
    }
    .btn-accent {
        display: inline-flex; align-items: center; gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        background: linear-gradient(135deg, #38c2ed 0%, #04a6e1 100%);
        color: white; font-weight: 600;
        border-radius: 0.625rem;
        box-shadow: 0 4px 14px -2px rgba(4, 166, 225, 0.45);
        transition: all 0.25s ease;
    }
    .btn-accent:hover { transform: translateY(-1px); box-shadow: 0 8px 20px -4px rgba(4, 166, 225, 0.55); }
    .premium-badge {
        display: inline-flex; align-items: center; gap: 0.375rem;
        padding: 0.25rem 0.75rem;
        background: linear-gradient(135deg, rgba(56, 194, 237, 0.15) 0%, rgba(4, 166, 225, 0.12) 100%);
        color: #0277b3;
        border: 1px solid rgba(4, 166, 225, 0.3);
        border-radius: 9999px;
        font-size: 0.75rem; font-weight: 700;
        letter-spacing: 0.05em; text-transform: uppercase;
    }
    .premium-badge svg { width: 0.875rem; height: 0.875rem; color: #04a6e1; }
    .accent-divider {
        height: 3px; width: 60px;
        background: linear-gradient(90deg, #04a6e1 0%, #38c2ed 100%);
        border-radius: 2px;
    }
    .hero-grid {
        background-image:
            linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px);
        background-size: 48px 48px;
    }
    .hero-bg { position: relative; overflow: hidden; }
    .hero-bg::after {
        content: '';
        position: absolute;
        inset: 0;
        background:
            linear-gradient(110deg,
                transparent 35%,
                rgba(4, 166, 225, 0.08) 47%,
                rgba(56, 194, 237, 0.14) 50%,
                rgba(4, 166, 225, 0.08) 53%,
                transparent 65%);
        background-size: 250% 100%;
        background-position: 50% 0%;
        pointer-events: none;
        z-index: 0;
        mix-blend-mode: screen;
    }
    .hero-bg::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 600 200' fill='none' stroke='%2304a6e1' stroke-width='0.6' stroke-opacity='0.35'><path d='M0 50 L120 50 L130 60 L260 60 L270 50 L600 50'/><path d='M0 150 L80 150 L90 140 L300 140 L310 150 L600 150'/></svg>");
        background-repeat: repeat;
        background-size: 600px 200px;
        opacity: 0.5;
        pointer-events: none;
        z-index: 0;
        mask-image: linear-gradient(180deg, transparent 0%, black 30%, black 70%, transparent 100%);
        -webkit-mask-image: linear-gradient(180deg, transparent 0%, black 30%, black 70%, transparent 100%);
    }
    .hero-bg > * { position: relative; z-index: 1; }
    .hero-watermark {
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        pointer-events: none;
        padding-top: 1.5rem;
    }
    .hero-watermark img {
        width: auto;
        height: 56px;
        max-width: 70%;
        opacity: 0.2;
        filter: brightness(0) invert(1);
        object-fit: contain;
    }
    @media (min-width: 768px) {
        .hero-watermark img { height: 76px; opacity: 0.22; }
    }
    @media (min-width: 1024px) {
        .hero-watermark img { height: 96px; opacity: 0.25; }
    }
    .gradient-text {
        background: linear-gradient(135deg, #38c2ed 0%, #04a6e1 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }
    .product-card { transition: all 0.3s cubic-bezier(0.4,0,0.2,1); }
    .product-card:hover { transform: translateY(-4px); }
    .product-card .icon-wrap { transition: all 0.3s ease; }
    .product-card:hover .icon-wrap { background: linear-gradient(135deg, #0277b3 0%, #04a6e1 100%); }
    .product-card:hover .icon-wrap img { filter: brightness(0) invert(1); }
    .nav-link {
        position: relative;
        padding: 0.5rem 0.25rem;
        font-family: 'Manrope', 'Inter', system-ui, sans-serif;
        font-weight: 600;
        font-size: 0.95rem;
        letter-spacing: 0.02em;
        transition: color 0.25s ease;
    }
    .nav-link::before {
        content: '';
        position: absolute;
        left: 50%; right: 50%;
        bottom: -2px;
        height: 3px;
        background: linear-gradient(90deg, #04a6e1 0%, #38c2ed 50%, #04a6e1 100%);
        border-radius: 2px;
        transition: left 0.35s cubic-bezier(0.4, 0, 0.2, 1), right 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.25s ease;
        opacity: 0;
    }
    .nav-link:hover::before,
    .nav-link.active::before {
        left: 0; right: 0;
        opacity: 1;
    }
    .nav-link::after {
        content: '';
        position: absolute;
        left: 0; right: 0; top: -6px; bottom: -6px;
        background: linear-gradient(180deg, rgba(4, 166, 225, 0.06) 0%, transparent 100%);
        border-radius: 0.5rem;
        opacity: 0;
        transition: opacity 0.25s ease;
        z-index: -1;
    }
    .nav-link:hover::after { opacity: 1; }
    .nav-link.active { color: #04a6e1 !important; font-weight: 700; }
    .nav-link:hover { color: #222222; }
    @keyframes fade-up { from { opacity:0; transform: translateY(20px); } to { opacity:1; transform: translateY(0); } }
    .fade-up { animation: fade-up 0.7s ease-out both; }
    .hero-slide {
        position: absolute; inset: 0;
        background-size: cover;
        background-position: center;
        opacity: 0;
        transition: opacity 1.2s ease-in-out;
    }
    .hero-slide.active { opacity: 1; }
    .hero-dot { width: 0.5rem; height: 0.5rem; border-radius: 9999px; background: rgba(255,255,255,0.4); transition: all 0.3s ease; cursor: pointer; }
    .hero-dot:hover { background: rgba(255,255,255,0.7); }
    .hero-dot.active { background: white; width: 1.5rem; }

    /* ---------------- Dark mode overrides ---------------- */
    html.dark { color-scheme: dark; }
    html.dark body {
        color: #e5e7eb;
        background: #0a0a0a !important;
        background-attachment: fixed;
    }
    html.dark body::before {
        background-image:
            linear-gradient(rgba(196, 236, 249, 0.025) 1px, transparent 1px),
            linear-gradient(90deg, rgba(196, 236, 249, 0.025) 1px, transparent 1px);
    }
    html.dark header.sticky { background-color: rgba(10, 10, 10, 0.92) !important; border-color: rgba(255,255,255,0.06) !important; }
    html.dark header::before { mix-blend-mode: screen; }
    html.dark header img { filter: brightness(0) invert(1); }
    html.dark .bg-white,
    html.dark .bg-white\/95 { background-color: #0a0a0a !important; }
    html.dark .bg-white\/90 { background-color: #0a0a0a !important; }
    html.dark .bg-white\/85 { background-color: #0a0a0a !important; }
    html.dark .bg-white\/80 { background-color: #0a0a0a !important; }
    html.dark .bg-white\/70 { background-color: #0a0a0a !important; }
    html.dark .bg-white\/60 { background-color: #0a0a0a !important; }
    html.dark .bg-white\/55 { background-color: #0a0a0a !important; }
    html.dark .bg-white\/50 { background-color: #0a0a0a !important; }
    html.dark .bg-navy-950 { background-color: #0a142b !important; }
    html.dark .bg-navy-900 { background-color: #0f1d33 !important; }
    html.dark .bg-navy-800 { background-color: #1a2f4a !important; }
    html.dark .hero-bg {
        background:
            radial-gradient(ellipse at top right, rgba(4, 166, 225, 0.18), transparent 50%),
            radial-gradient(ellipse at bottom left, rgba(56, 194, 237, 0.10), transparent 55%),
            radial-gradient(ellipse at top left, rgba(2, 119, 179, 0.18), transparent 50%),
            linear-gradient(135deg, #000000 0%, #0a0a0a 50%, #141414 100%);
    }
    html.dark .bg-navy-50\/30 { background-color: rgba(255,255,255,0.025) !important; }
    html.dark .bg-navy-50\/40 { background-color: rgba(255,255,255,0.035) !important; }
    html.dark .bg-navy-50\/50 { background-color: rgba(255,255,255,0.04) !important; }
    html.dark .bg-blue-100 { background-color: rgba(4, 166, 225, 0.18) !important; }
    html.dark .bg-emerald-50 { background-color: rgba(4, 166, 225, 0.12) !important; }
    html.dark .bg-emerald-100 { background-color: rgba(4, 166, 225, 0.18) !important; }
    html.dark .bg-gold-50 { background-color: rgba(4, 166, 225, 0.12) !important; }
    html.dark .border-blue-100 { border-color: rgba(4, 166, 225, 0.28) !important; }
    html.dark .border-blue-200 { border-color: rgba(4, 166, 225, 0.3) !important; }
    html.dark .border-emerald-100 { border-color: rgba(4, 166, 225, 0.28) !important; }
    html.dark .text-blue-700,
    html.dark .text-blue-800,
    html.dark .text-blue-900 { color: #38c2ed !important; }
    html.dark .text-blue-600 { color: #38c2ed !important; }
    html.dark .text-brand,
    html.dark .text-brand-dark { color: #38c2ed !important; }
    html.dark .text-brand-light { color: #8fd9f3 !important; }
    html.dark .text-emerald-600,
    html.dark .text-emerald-700 { color: #38c2ed !important; }
    html.dark .text-emerald-800,
    html.dark .text-emerald-900 { color: #8fd9f3 !important; }
    html.dark .bg-green-50 { background-color: rgba(4, 166, 225, 0.10) !important; }
    html.dark .bg-green-100 { background-color: rgba(4, 166, 225, 0.16) !important; }
    html.dark .text-green-600,
    html.dark .text-green-700,
    html.dark .text-green-800 { color: #38c2ed !important; }
    html.dark .text-navy-900 { color: #fafafa !important; }
    html.dark .text-navy-800 { color: #f4f4f5 !important; }
    html.dark .text-navy-700 { color: #e4e4e7 !important; }
    html.dark .text-navy-600 { color: #d4d4d8 !important; }
    html.dark .text-navy-500 { color: #a1a1aa !important; }
    html.dark .text-navy-400 { color: #a1a1aa !important; }
    html.dark .text-navy-300 { color: #d4d4d8 !important; }
    html.dark .text-navy-100 { color: #e4e4e7 !important; }
    html.dark .text-gray-900 { color: #fafafa !important; }
    html.dark .text-gray-800 { color: #f4f4f5 !important; }
    html.dark .text-gray-700 { color: #e4e4e7 !important; }
    html.dark .text-gray-600 { color: #d4d4d8 !important; }
    html.dark .text-gray-500 { color: #a1a1aa !important; }
    html.dark .text-black { color: #fafafa !important; }
    html.dark .border-navy-100 { border-color: rgba(255,255,255,0.08) !important; }
    html.dark .border-navy-200 { border-color: rgba(255,255,255,0.10) !important; }
    html.dark .border-gray-100,
    html.dark .border-gray-200 { border-color: rgba(255,255,255,0.08) !important; }
    html.dark .divide-navy-100 > :not([hidden]) ~ :not([hidden]) { border-color: rgba(255,255,255,0.08) !important; }
    html.dark .bg-navy-50,
    html.dark .bg-navy-50\/40 { background-color: rgba(255,255,255,0.04) !important; }
    html.dark .bg-gray-50,
    html.dark .bg-gray-100 { background-color: rgba(255,255,255,0.04) !important; }
    html.dark .bg-blue-50 { background-color: rgba(4,166,225,0.12) !important; }
    html.dark .hover\:bg-navy-50:hover { background-color: rgba(255,255,255,0.06) !important; }
    html.dark .hover\:bg-white:hover { background-color: rgba(255,255,255,0.08) !important; }
    html.dark .hover\:text-navy-900:hover { color: #ffffff !important; }
    html.dark .nav-link.active { color: #38c2ed !important; }
    html.dark .nav-link:hover { color: #ffffff; }
    html.dark .shadow-card,
    html.dark .shadow-card-hover { box-shadow: 0 8px 28px -8px rgba(0,0,0,0.85) !important; }
    html.dark .premium-badge {
        background: linear-gradient(135deg, rgba(56, 194, 237, 0.18) 0%, rgba(4, 166, 225, 0.14) 100%);
        color: #8fd9f3;
        border-color: rgba(4, 166, 225, 0.45);
    }

    /* ---------------- Page-Navy hero (Contact/Customer/Category) ---------------- */
    body.page-navy .hero-bg,
    html.dark body.page-navy .hero-bg {
        background: #0a142b !important;
    }
    body.page-navy .hero-bg::before,
    body.page-navy .hero-bg::after,
    body.page-navy .hero-grid { display: none !important; }

    /* ---------------- Italray palette overrides ---------------- */
    /* Map Tailwind's default green/emerald utilities to brand cyan */
    .text-emerald-50, .text-emerald-100 { color: #c4ecf9 !important; }
    .text-emerald-200, .text-emerald-300 { color: #8fd9f3 !important; }
    .text-emerald-400, .text-emerald-500 { color: #04a6e1 !important; }
    .text-emerald-600, .text-emerald-700 { color: #0277b3 !important; }
    .text-emerald-800, .text-emerald-900 { color: #024d68 !important; }
    .bg-emerald-50 { background-color: #e6f7fd !important; }
    .bg-emerald-100 { background-color: #c4ecf9 !important; }
    .bg-emerald-200 { background-color: #8fd9f3 !important; }
    .bg-emerald-500 { background-color: #04a6e1 !important; }
    .bg-emerald-600 { background-color: #0388b9 !important; }
    .border-emerald-100 { border-color: #c4ecf9 !important; }
    .border-emerald-200 { border-color: #8fd9f3 !important; }
    .border-emerald-300 { border-color: #5ac6ed !important; }
    .border-emerald-500 { border-color: #04a6e1 !important; }
    .text-green-500, .text-green-600 { color: #04a6e1 !important; }
    .text-green-700, .text-green-800, .text-green-900 { color: #0277b3 !important; }
    .bg-green-50 { background-color: #e6f7fd !important; }
    .bg-green-100 { background-color: #c4ecf9 !important; }
    .bg-green-500, .bg-green-600 { background-color: #04a6e1 !important; }
    .border-green-100 { border-color: #c4ecf9 !important; }
    .border-green-200 { border-color: #8fd9f3 !important; }
    .ring-emerald-500, .ring-green-500 { --tw-ring-color: #04a6e1 !important; }
    .from-emerald-500, .from-green-500 { --tw-gradient-from: #04a6e1 !important; }
    .from-emerald-600, .from-green-600 { --tw-gradient-from: #0388b9 !important; }
    .to-emerald-500, .to-green-500 { --tw-gradient-to: #04a6e1 !important; }
    .to-emerald-600, .to-green-600 { --tw-gradient-to: #0388b9 !important; }
    .via-emerald-500, .via-green-500 { --tw-gradient-stops: var(--tw-gradient-from), #04a6e1, var(--tw-gradient-to, transparent) !important; }
</style>
