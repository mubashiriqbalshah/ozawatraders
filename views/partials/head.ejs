    html.dark .bg-white\/70 { background-color: rgba(8, 18, 35, 0.7) !important; }
    html.dark .bg-white\/60 { background-color: rgba(8, 18, 35, 0.6) !important; }
    html.dark .bg-white\/55 { background-color: rgba(8, 18, 35, 0.55) !important; }
    html.dark .bg-white\/50 { background-color: rgba(8, 18, 35, 0.5) !important; }
