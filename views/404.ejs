<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { pageTitle }) %>
</head>
<body class="text-navy-900 antialiased">
    <%- include('partials/header') %>

    <section class="hero-bg relative overflow-hidden text-white pt-28 md:pt-32 lg:pt-40 pb-20 lg:pb-28">
        <div class="hero-grid absolute inset-0"></div>
        <div class="hero-watermark"><img src="<%= content.site.logo %>" alt=""></div>
        <div class="relative max-w-3xl mx-auto px-6 text-center">
            <span class="inline-block px-3 py-1 rounded-full bg-blue-500/15 text-blue-300 border border-blue-500/30 text-sm font-semibold mb-4">404</span>
            <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-extrabold leading-tight mb-4">Page Not Found</h1>
            <p class="text-lg text-navy-200 leading-relaxed mb-8">The page you are looking for does not exist or has been moved.</p>
            <div class="flex flex-wrap items-center justify-center gap-3">
                <a href="/" class="inline-flex items-center gap-2 px-6 py-3 bg-blue-500 hover:bg-blue-600 text-white rounded-lg font-semibold transition shadow-lg shadow-blue-500/25">
                    Go Home
                </a>
                <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3 bg-white/10 hover:bg-white/20 text-white border border-white/20 rounded-lg font-semibold backdrop-blur-sm transition">
                    Contact Us
                </a>
            </div>
        </div>
    </section>

    <%- include('partials/footer') %>
</body>
</html>
