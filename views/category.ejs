<!DOCTYPE html>
<html lang="en">
<head>
    <% const cat = content.categories[categoryKey]; const pageTitle = cat.title + ' — ' + content.site.name; %>
    <%- include('partials/head', { pageTitle }) %>
</head>
<body class="text-navy-900 antialiased">
    <%- include('partials/header') %>

    <% const _isSliderMode = cat.display_mode === 'slider'; %>

    <% if (_isSliderMode) { %>
    <!-- Slider-only mode: hero-bg with animations + heading + image carousel -->
    <section class="hero-bg relative overflow-hidden text-white pt-28 md:pt-32 pb-6">
        <div class="hero-grid absolute inset-0"></div>
        <div class="hero-watermark"><img src="<%= content.site.logo %>" alt=""></div>
        <div class="relative max-w-4xl mx-auto px-6">
            <a href="/" class="inline-flex items-center gap-2 text-blue-300 hover:text-blue-200 text-sm font-medium mb-5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                Back to Home
            </a>
            <div class="text-center">
                <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight"><%= cat.title %></h1>
                <div class="accent-divider mt-4 mx-auto"></div>
            </div>
        </div>
    </section>

    <section class="hero-bg relative overflow-hidden pb-12">
        <div class="hero-grid absolute inset-0"></div>
        <div class="relative max-w-4xl mx-auto px-6 flex justify-center">
            <% if (cat.gallery && cat.gallery.length) { %>
            <div id="catSlider" class="relative w-full max-w-4xl aspect-[16/9] overflow-hidden rounded-2xl shadow-2xl bg-navy-900 lightbox-gallery">
                <% cat.gallery.forEach((src, i) => { %>
                <div class="cat-slide absolute inset-0 flex items-center justify-center p-2 transition-opacity duration-700 <%= i === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0' %>" data-idx="<%= i %>">
                    <img src="<%= src %>" alt="" class="max-w-full max-h-full w-auto h-auto object-contain">
                </div>
                <% }) %>

                <% if (cat.gallery.length > 1) { %>
                <button type="button" class="cat-prev absolute left-4 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-white/90 hover:bg-white shadow-card flex items-center justify-center text-navy-900 z-20 transition" aria-label="Previous">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                </button>
                <button type="button" class="cat-next absolute right-4 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-white/90 hover:bg-white shadow-card flex items-center justify-center text-navy-900 z-20 transition" aria-label="Next">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                </button>
                <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex items-center gap-2 z-20">
                    <% cat.gallery.forEach((_, i) => { %>
                    <button type="button" data-idx="<%= i %>" class="cat-dot transition-all <%= i === 0 ? 'bg-white w-6 h-2' : 'bg-white/40 hover:bg-white/70 w-2 h-2' %> rounded-full" aria-label="Go to slide <%= i + 1 %>"></button>
                    <% }) %>
                </div>
                <% } %>
            </div>
            <% } else { %>
            <div class="w-full max-w-4xl aspect-[16/9] rounded-2xl border-2 border-dashed border-white/20 bg-navy-900/50 flex flex-col items-center justify-center text-center px-6">
                <svg class="w-16 h-16 text-blue-400 mb-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                <p class="text-white font-display font-bold text-lg">No images yet</p>
                <p class="text-navy-300 text-sm mt-2">Upload images from admin panel to populate the slider.</p>
            </div>
            <% } %>
        </div>
    </section>

    <% if (cat.gallery && cat.gallery.length > 1) { %>
    <script>
    (function() {
        const slider = document.getElementById('catSlider');
        if (!slider) return;
        const slides = slider.querySelectorAll('.cat-slide');
        const dots = slider.querySelectorAll('.cat-dot');
        const prev = slider.querySelector('.cat-prev');
        const next = slider.querySelector('.cat-next');
        let current = 0; let timer;
        function show(idx) {
            slides.forEach((s, i) => {
                s.classList.toggle('opacity-100', i === idx);
                s.classList.toggle('z-10', i === idx);
                s.classList.toggle('opacity-0', i !== idx);
                s.classList.toggle('z-0', i !== idx);
            });
            dots.forEach((d, i) => {
                if (i === idx) { d.classList.add('bg-white', 'w-6'); d.classList.remove('bg-white/40', 'w-2'); }
                else { d.classList.remove('bg-white', 'w-6'); d.classList.add('bg-white/40', 'w-2'); }
            });
            current = idx;
        }
        function play() { timer = setInterval(() => show((current + 1) % slides.length), 5000); }
        function reset() { clearInterval(timer); play(); }
        prev && prev.addEventListener('click', () => { show((current - 1 + slides.length) % slides.length); reset(); });
        next && next.addEventListener('click', () => { show((current + 1) % slides.length); reset(); });
        dots.forEach((d, i) => d.addEventListener('click', () => { show(i); reset(); }));
        play();
    })();
    </script>
    <% } %>

    <% } else { %>
    <!-- Standard mode: hero + products + gallery -->
    <section class="hero-bg relative overflow-hidden text-white pt-28 md:pt-32 lg:pt-40 pb-20 lg:pb-28">
        <div class="hero-grid absolute inset-0"></div>
        <div class="hero-watermark"><img src="<%= content.site.logo %>" alt=""></div>
        <div class="relative max-w-7xl mx-auto px-6">
            <a href="/" class="inline-flex items-center gap-2 text-blue-300 hover:text-blue-200 text-sm font-medium mb-6">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                Back to Home
            </a>
            <div class="max-w-3xl">
                <span class="inline-block px-3 py-1 rounded-full bg-blue-500/15 text-blue-300 border border-blue-500/30 text-sm font-semibold mb-4">Solutions</span>
                <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-extrabold leading-tight mb-4"><%= cat.title %></h1>
                <p class="text-lg text-navy-200 leading-relaxed"><%= cat.description %></p>
            </div>
        </div>
    </section>

    <% if (cat.products && cat.products.length) { %>
    <section class="py-20 lg:py-28 bg-white/55 backdrop-blur-[2px]">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <% cat.products.forEach(p => { %>
                <article class="rounded-2xl overflow-hidden shadow-card hover:shadow-card-hover transition bg-white border border-navy-100 flex flex-col">
                    <div class="bg-white overflow-hidden flex items-center justify-center p-4 border-b border-navy-100 h-[360px]">
                        <img src="<%= p.image %>" alt="<%= p.title %>" class="max-w-full max-h-full w-auto h-auto object-contain" onerror="this.style.opacity='0.2';this.alt='Image coming soon';">
                    </div>
                    <div class="p-6 flex-1 flex flex-col">
                        <% if (p.tagline) { %>
                        <span class="inline-block self-start px-2.5 py-1 rounded-full bg-blue-50 text-blue-700 border border-blue-100 text-xs font-semibold mb-3"><%= p.tagline %></span>
                        <% } %>
                        <h3 class="font-display text-xl md:text-2xl font-extrabold text-navy-900 mb-2"><%= p.title %></h3>
                        <p class="text-navy-700 leading-relaxed mb-4"><%= p.summary %></p>
                        <% if (p.highlights && p.highlights.length) { %>
                        <ul class="mt-auto space-y-1.5 text-sm text-navy-700">
                            <% p.highlights.forEach(h => { %>
                            <li class="flex gap-2">
                                <svg class="w-4 h-4 text-blue-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                                <span><%= h %></span>
                            </li>
                            <% }) %>
                        </ul>
                        <% } %>
                    </div>
                </article>
                <% }) %>
            </div>
        </div>
    </section>
    <% } %>

    <% if (cat.gallery && cat.gallery.length) { %>
    <section class="<%= (cat.products && cat.products.length) ? 'pb-20 lg:pb-28' : 'py-20 lg:py-28' %> bg-white/55 backdrop-blur-[2px]">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lightbox-gallery">
                <% cat.gallery.forEach(src => { %>
                <div class="group aspect-[4/3] rounded-2xl overflow-hidden shadow-card hover:shadow-card-hover transition bg-navy-50">
                    <img src="<%= src %>" alt="" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                </div>
                <% }) %>
            </div>
        </div>
    </section>
    <% } else if (!(cat.products && cat.products.length)) { %>
    <section class="py-20 bg-white/55 backdrop-blur-[2px]">
        <div class="max-w-7xl mx-auto px-6 text-center">
            <p class="text-navy-500">Gallery coming soon.</p>
        </div>
    </section>
    <% } %>

    <section class="py-16 bg-navy-50">
        <div class="max-w-4xl mx-auto px-6 text-center">
            <h2 class="font-display text-2xl md:text-3xl font-extrabold text-navy-900 mb-3">Need more information?</h2>
            <p class="text-navy-700 mb-6">Talk to our team about <%= cat.title.toLowerCase() %> requirements for your facility.</p>
            <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3.5 bg-brand text-white rounded-lg font-semibold hover:bg-navy-800 transition shadow-md">
                Contact Us
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
        </div>
    </section>
    <% } %>

    <%- include('partials/lightbox') %>
    <%- include('partials/footer') %>
</body>
</html>
