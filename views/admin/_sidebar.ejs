<% const path = req.path; %>
<aside class="hidden lg:flex flex-col fixed inset-y-0 left-0 w-64 bg-navy-950 text-white border-r border-navy-800">
    <div class="px-6 py-5 border-b border-navy-800">
        <a href="/admin" class="flex items-center gap-3">
            <img src="<%= content.site.logo %>" alt="" class="h-9 w-auto">
            <div>
                <div class="font-display font-bold text-sm leading-tight">Ozawa</div>
                <div class="text-[10px] uppercase tracking-wider text-blue-300">Admin Panel</div>
            </div>
        </a>
    </div>
    <nav class="flex-1 overflow-y-auto py-4 px-3 space-y-1">
        <% const links = [
            { href: '/admin', label: 'Dashboard', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
            { href: '/admin/home', label: 'Home Page', icon: 'M5 13l4 4L19 7' },
            { href: '/admin/products', label: 'Products', icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4' },
            { href: '/admin/certificates', label: 'Certificates', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' },
            { href: '/admin/customers', label: 'Customers', icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2' },
            { href: '/admin/category/power-cabinet', label: 'Power Cabinet', icon: 'M4 4v16h16' },
            { href: '/admin/category/matismart-breaker', label: 'Matismart Breaker', icon: 'M4 4v16h16' },
            { href: '/admin/category/earth-resistance-tester', label: 'Earth Resistance Tester', icon: 'M4 4v16h16' },
            { href: '/admin/category/micro-feeder', label: 'Micro Feeder', icon: 'M4 4v16h16' },
            { href: '/admin/category/dilution-tank', label: 'Dilution Tank', icon: 'M4 4v16h16' },
            { href: '/admin/category/rad', label: 'Radiology', icon: 'M4 4v16h16' },
            { href: '/admin/category/card', label: 'Cardiology', icon: 'M4 4v16h16' },
            { href: '/admin/category/physio', label: 'Physiotherapy', icon: 'M4 4v16h16' },
            { href: '/admin/category/ambu', label: 'Ambulances', icon: 'M4 4v16h16' },
            { href: '/admin/messages', label: 'Messages', icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z', badge: typeof unreadMessages !== 'undefined' ? unreadMessages : 0 },
            { href: '/admin/contact', label: 'Contact Info', icon: 'M3 5a2 2 0 012-2h2.5a1 1 0 01.95.68l1.5 4.5a1 1 0 01-.5 1.21l-1.7.85a11 11 0 005.5 5.5l.85-1.7a1 1 0 011.21-.5l4.5 1.5a1 1 0 01.68.95V19a2 2 0 01-2 2h-1C9.4 21 3 14.6 3 6V5z' },
            { href: '/admin/site', label: 'Site / Footer / Maintenance', icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
            { href: '/admin/settings', label: 'Account / Logo', icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z' }
        ]; %>
        <% links.forEach(l => { const active = path === l.href || (l.href !== '/admin' && path.startsWith(l.href)); %>
        <a href="<%= l.href %>" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium <%= active ? 'bg-blue-500/15 text-white border-l-2 border-blue-400' : 'text-navy-300 hover:text-white hover:bg-navy-800' %>">
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="<%= l.icon %>"/></svg>
            <span class="flex-1"><%= l.label %></span>
            <% if (l.badge && l.badge > 0) { %>
            <span class="px-2 py-0.5 rounded-full bg-blue-500 text-white text-[10px] font-bold"><%= l.badge %></span>
            <% } %>
        </a>
        <% }) %>
    </nav>
    <div class="border-t border-navy-800 p-4">
        <div class="flex items-center justify-between text-xs">
            <div>
                <div class="text-navy-400">Signed in</div>
                <div class="font-semibold text-white"><%= currentUser.username %></div>
            </div>
            <form method="POST" action="/admin/logout">
                <button type="submit" class="px-3 py-1.5 rounded-md bg-navy-800 hover:bg-navy-700 text-navy-200 hover:text-white transition" title="Logout">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                </button>
            </form>
        </div>
        <a href="/" target="_blank" class="mt-3 flex items-center justify-center gap-2 px-3 py-2 bg-blue-500/15 text-blue-300 rounded-md text-xs font-semibold hover:bg-blue-500/25 transition">
            View Public Site
            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
    </div>
</aside>
