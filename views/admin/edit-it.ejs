<!DOCTYPE html>
<html lang="en">
<head>
    <% const pageTitle = 'IT Section'; %>
    <%- include('_head', { pageTitle }) %>
</head>
<body class="bg-navy-50/30 text-navy-900 min-h-screen">
    <%- include('_sidebar') %>
    <%- include('_topbar') %>
    <main class="lg:ml-64 px-6 lg:px-10 py-8 lg:py-10 max-w-3xl">
        <%- include('_flash') %>

        <% const it = content.it || {}; const t = it.tenders || {};
           const servicesText = (it.services || []).map(s => `${s.title} | ${s.description}`).join('\n');
           const pointsText = (t.points || []).join('\n');
           const listingsText = (t.listings || []).map(l => [l.title, l.department, l.ref, l.category, l.date, l.url].join(' | ')).join('\n'); %>

        <div class="mb-8 flex items-center justify-between gap-4">
            <div>
                <h1 class="font-display text-3xl font-extrabold text-navy-900 mb-1">IT &amp; Software Section</h1>
                <p class="text-navy-600">Edit the IT page, services and Government (PPRA) tenders block.</p>
            </div>
            <a href="/it" target="_blank" class="btn-secondary !py-2 !px-3 !text-sm whitespace-nowrap">View Page →</a>
        </div>

        <form method="POST" action="/admin/it" class="space-y-6">
            <!-- Hero -->
            <div class="card p-6 space-y-4">
                <h2 class="font-display text-lg font-bold">Hero</h2>
                <div><label class="form-label">Badge</label><input type="text" name="hero_badge" value="<%= it.hero_badge || '' %>" class="form-input"></div>
                <div><label class="form-label">Title</label><input type="text" name="hero_title" value="<%= it.hero_title || '' %>" class="form-input"></div>
                <div><label class="form-label">Subtitle</label><textarea name="hero_subtitle" rows="3" class="form-input"><%= it.hero_subtitle || '' %></textarea></div>
            </div>

            <!-- Intro -->
            <div class="card p-6 space-y-4">
                <h2 class="font-display text-lg font-bold">Intro</h2>
                <div><label class="form-label">Intro Title</label><input type="text" name="intro_title" value="<%= it.intro_title || '' %>" class="form-input"></div>
                <div><label class="form-label">Intro Paragraph</label><textarea name="intro_paragraph" rows="4" class="form-input"><%= it.intro_paragraph || '' %></textarea></div>
            </div>

            <!-- Services -->
            <div class="card p-6 space-y-4">
                <h2 class="font-display text-lg font-bold">Services</h2>
                <div class="grid sm:grid-cols-2 gap-4">
                    <div><label class="form-label">Section Pill</label><input type="text" name="services_subtitle" value="<%= it.services_subtitle || '' %>" class="form-input"></div>
                    <div><label class="form-label">Section Title</label><input type="text" name="services_title" value="<%= it.services_title || '' %>" class="form-input"></div>
                </div>
                <div><label class="form-label">Section Description</label><input type="text" name="services_description" value="<%= it.services_description || '' %>" class="form-input"></div>
                <div>
                    <label class="form-label">Service Cards <span class="text-navy-500 text-xs">— one per line, format: <code>Title | Description</code></span></label>
                    <textarea name="services" rows="8" class="form-input font-mono text-xs" placeholder="Custom Software Development | Tailored applications built around your workflows"><%= servicesText %></textarea>
                </div>
            </div>

            <!-- Government Tenders (PPRA) -->
            <div class="card p-6 space-y-4">
                <h2 class="font-display text-lg font-bold">Government Tenders (PPRA)</h2>
                <div class="grid sm:grid-cols-2 gap-4">
                    <div><label class="form-label">Section Pill</label><input type="text" name="tenders_subtitle" value="<%= t.subtitle || '' %>" class="form-input"></div>
                    <div><label class="form-label">Section Title</label><input type="text" name="tenders_title" value="<%= t.title || '' %>" class="form-input"></div>
                </div>
                <div><label class="form-label">Description</label><textarea name="tenders_description" rows="4" class="form-input"><%= t.description || '' %></textarea></div>
                <div>
                    <label class="form-label">Bullet Points <span class="text-navy-500 text-xs">— one per line</span></label>
                    <textarea name="tenders_points" rows="5" class="form-input"><%= pointsText %></textarea>
                </div>
                <div class="grid sm:grid-cols-2 gap-4">
                    <div><label class="form-label">Button Text</label><input type="text" name="tenders_cta_text" value="<%= t.cta_text || '' %>" class="form-input"></div>
                    <div><label class="form-label">Button Link (PPRA URL)</label><input type="text" name="tenders_cta_href" value="<%= t.cta_href || '' %>" class="form-input font-mono text-xs" placeholder="https://epms.ppra.gov.pk/public/tenders/active-tenders"></div>
                </div>
                <div><label class="form-label">Filter Hint <span class="text-navy-500 text-xs">(small note shown under the buttons)</span></label><input type="text" name="tenders_filter_hint" value="<%= t.filter_hint || '' %>" class="form-input" placeholder='On PPRA, set Sector filter to "Info and Comm Tech".'></div>
            </div>

            <!-- Tender Listings -->
            <div class="card p-6 space-y-4">
                <h2 class="font-display text-lg font-bold">Tender Listings (PPRA opportunities)</h2>
                <div><label class="form-label">Listings Heading</label><input type="text" name="tenders_listings_title" value="<%= t.listings_title || '' %>" class="form-input"></div>
                <div><label class="form-label">Listings Note</label><textarea name="tenders_listings_note" rows="3" class="form-input"><%= t.listings_note || '' %></textarea></div>
                <div>
                    <label class="form-label">Tender Cards <span class="text-navy-500 text-xs">— one per line, format: <code>Title | Department | Ref | Category | Date | URL</code></span></label>
                    <textarea name="tenders_listings" rows="8" class="form-input font-mono text-[11px]" placeholder="Online Services & Software | PIDE | GS/06/2026 | Software / Services | 2026 | https://epms.ppra.gov.pk/public/tenders/active-tenders"><%= listingsText %></textarea>
                    <p class="text-xs text-navy-500 mt-1">Leave a field blank but keep the <code>|</code> separators if a value is unknown. Tip: copy a tender's link from <a href="https://epms.ppra.gov.pk/public/tenders/active-tenders" target="_blank" class="text-brand">PPRA Active Tenders</a>.</p>
                </div>
                <div class="grid sm:grid-cols-2 gap-4">
                    <div><label class="form-label">"Browse Live" Button Text</label><input type="text" name="tenders_live_text" value="<%= t.live_text || '' %>" class="form-input"></div>
                    <div><label class="form-label">"Browse Live" Button Link</label><input type="text" name="tenders_live_href" value="<%= t.live_href || '' %>" class="form-input font-mono text-xs" placeholder="https://epms.ppra.gov.pk/public/tenders/active-tenders"></div>
                </div>
            </div>

            <div class="flex justify-end"><button class="btn-primary">Save IT Section</button></div>
        </form>
    </main>
</body>
</html>
