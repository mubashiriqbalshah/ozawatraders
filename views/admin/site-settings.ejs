<!DOCTYPE html>
<html lang="en">
<head>
    <% const pageTitle = 'Site Settings'; %>
    <%- include('_head', { pageTitle }) %>
</head>
<body class="bg-navy-50/30 text-navy-900 min-h-screen">
    <%- include('_sidebar') %>
    <%- include('_topbar') %>
    <main class="lg:ml-64 px-6 lg:px-10 py-8 lg:py-10 max-w-5xl">
        <%- include('_flash') %>

        <div class="mb-8">
            <h1 class="font-display text-3xl font-extrabold text-navy-900 mb-1">Site Settings</h1>
            <p class="text-navy-600">Edit site-wide info, footer, and maintenance mode.</p>
        </div>

        <div class="card p-6 mb-6">
            <h2 class="font-display text-lg font-bold mb-4">Site Info</h2>
            <form method="POST" action="/admin/site/info" class="space-y-4">
                <div class="grid sm:grid-cols-2 gap-4">
                    <div><label class="form-label">Site Name</label><input type="text" name="name" value="<%= content.site.name %>" class="form-input"></div>
                    <div><label class="form-label">Phone</label><input type="text" name="phone" value="<%= content.site.phone %>" class="form-input"></div>
                </div>
                <div class="grid sm:grid-cols-2 gap-4">
                    <div><label class="form-label">Email</label><input type="text" name="email" value="<%= content.site.email %>" class="form-input"></div>
                    <div class="flex items-center gap-2 pt-7"><input type="checkbox" name="iso_certified" id="iso" <%= content.site.iso_certified ? 'checked' : '' %>><label for="iso" class="text-sm">ISO Certified</label></div>
                </div>
                <div class="grid sm:grid-cols-2 gap-4">
                    <div><label class="form-label">Tagline</label><input type="text" name="tagline" value="<%= content.site.tagline %>" class="form-input"></div>
                    <div><label class="form-label">Trusted Since</label><input type="text" name="trusted_since" value="<%= content.site.trusted_since %>" class="form-input"></div>
                </div>

                <hr class="my-4 border-navy-100">
                <h3 class="font-display text-base font-bold text-navy-700">Browser Tab / SEO</h3>

                <div>
                    <label class="form-label">Browser Tab Subtitle <span class="text-navy-500 text-xs">(shows after "Ozawa Traders —" in tab)</span></label>
                    <input type="text" name="meta_subtitle" value="<%= content.site.meta_subtitle || '' %>" class="form-input" placeholder="IT, Industrial, Power & Medical Solutions">
                    <p class="text-xs text-navy-500 mt-1">Example: "IT, Industrial, Power & Medical Solutions" → tab shows: "Ozawa Traders — IT, Industrial, Power & Medical Solutions"</p>
                </div>
                <div><label class="form-label">Meta Description <span class="text-navy-500 text-xs">(SEO — Google search snippet)</span></label><textarea name="meta_description" rows="2" class="form-input"><%= content.site.meta_description || '' %></textarea></div>
                <div><label class="form-label">Meta Keywords <span class="text-navy-500 text-xs">(comma-separated)</span></label><textarea name="meta_keywords" rows="2" class="form-input"><%= content.site.meta_keywords || '' %></textarea></div>

                <div class="flex justify-end"><button class="btn-primary">Save Site Info</button></div>
            </form>
        </div>

        <div class="card p-6 mb-6">
            <h2 class="font-display text-lg font-bold mb-4">Footer</h2>
            <form method="POST" action="/admin/site/footer" class="space-y-5" id="footerForm">
                <div><label class="form-label">Description</label><textarea name="description" rows="2" class="form-input"><%= content.footer.description %></textarea></div>
                <div class="grid sm:grid-cols-2 gap-4">
                    <div><label class="form-label">Address</label><input type="text" name="address" value="<%= content.footer.address %>" class="form-input"></div>
                    <div><label class="form-label">Copyright</label><input type="text" name="copyright" value="<%= content.footer.copyright %>" class="form-input"></div>
                </div>
                <div class="grid sm:grid-cols-2 gap-4">
                    <div><label class="form-label">Credit Name</label><input type="text" name="credit_name" value="<%= content.footer.credit_name %>" class="form-input"></div>
                    <div><label class="form-label">Credit Link</label><input type="text" name="credit_link" value="<%= content.footer.credit_link %>" class="form-input"></div>
                </div>

                <div class="border-t border-navy-100 pt-5">
                    <div class="flex items-center justify-between mb-3">
                        <h3 class="font-display font-bold text-navy-900">Footer Link Columns</h3>
                        <button type="button" id="addColBtn" class="btn-secondary !py-2 !px-3 !text-sm flex items-center gap-1.5">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                            Add Column
                        </button>
                    </div>
                    <p class="text-xs text-navy-500 mb-3">Each line in "Links" should be: <code class="bg-navy-50 px-1.5 py-0.5 rounded">Label | /url</code> &mdash; e.g. <code class="bg-navy-50 px-1.5 py-0.5 rounded">Home | /</code></p>

                    <div id="colsContainer" class="space-y-4">
                        <% (content.footer.columns || []).forEach((col, i) => { %>
                        <div class="col-block rounded-xl border border-navy-200 bg-white p-4" data-idx="<%= i %>">
                            <div class="flex items-center justify-between mb-3">
                                <span class="text-xs uppercase tracking-wider font-bold text-navy-400">Column #<span class="col-num"><%= i + 1 %></span></span>
                                <button type="button" class="remove-col-btn text-red-500 hover:text-red-700 text-xs font-semibold flex items-center gap-1">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                                    Remove
                                </button>
                            </div>
                            <div class="space-y-3">
                                <div>
                                    <label class="form-label">Column Title</label>
                                    <input type="text" name="cols_<%= i %>_title" value="<%= col.title || '' %>" class="form-input col-title-input" placeholder="e.g. Company">
                                </div>
                                <div>
                                    <label class="form-label">Links (one per line: <code>Label | /url</code>)</label>
                                    <textarea name="cols_<%= i %>_links" rows="6" class="form-input font-mono text-xs col-links-input" placeholder="Home | /&#10;Customers | /customer"><%
                                    if (col.links && col.links.length) {
                                        col.links.forEach((link, j) => {
                                    %><%= link.label %> | <%= link.href %><%= j < col.links.length - 1 ? '\n' : '' %><%
                                        });
                                    }
                                    %></textarea>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                    </div>
                </div>

                <div class="flex justify-end pt-2"><button class="btn-primary">Save Footer</button></div>
            </form>
        </div>

        <template id="colTemplate">
            <div class="col-block rounded-xl border border-navy-200 bg-white p-4">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-xs uppercase tracking-wider font-bold text-navy-400">Column #<span class="col-num"></span></span>
                    <button type="button" class="remove-col-btn text-red-500 hover:text-red-700 text-xs font-semibold flex items-center gap-1">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                        Remove
                    </button>
                </div>
                <div class="space-y-3">
                    <div>
                        <label class="form-label">Column Title</label>
                        <input type="text" class="form-input col-title-input" placeholder="e.g. Resources">
                    </div>
                    <div>
                        <label class="form-label">Links (one per line: <code>Label | /url</code>)</label>
                        <textarea rows="6" class="form-input font-mono text-xs col-links-input" placeholder="Privacy | /privacy&#10;Terms | /terms"></textarea>
                    </div>
                </div>
            </div>
        </template>

        <script>
        (function() {
            const container = document.getElementById('colsContainer');
            const addBtn = document.getElementById('addColBtn');
            const tpl = document.getElementById('colTemplate');

            function renumber() {
                const blocks = container.querySelectorAll('.col-block');
                blocks.forEach((b, i) => {
                    b.dataset.idx = i;
                    const num = b.querySelector('.col-num');
                    if (num) num.textContent = i + 1;
                    const titleInput = b.querySelector('.col-title-input');
                    const linksInput = b.querySelector('.col-links-input');
                    if (titleInput) titleInput.name = 'cols_' + i + '_title';
                    if (linksInput) linksInput.name = 'cols_' + i + '_links';
                });
            }

            function attachRemove(block) {
                const btn = block.querySelector('.remove-col-btn');
                if (!btn) return;
                btn.addEventListener('click', () => {
                    if (confirm('Remove this footer column and all its links?')) {
                        block.remove();
                        renumber();
                    }
                });
            }

            container.querySelectorAll('.col-block').forEach(attachRemove);

            addBtn.addEventListener('click', () => {
                const clone = tpl.content.cloneNode(true);
                const block = clone.querySelector('.col-block');
                container.appendChild(clone);
                attachRemove(block);
                renumber();
                block.querySelector('.col-title-input').focus();
            });
        })();
        </script>

        <div class="card p-6 mb-6 border-2 <%= maintenanceOn ? 'border-amber-300 bg-amber-50/40' : 'border-navy-100' %>">
            <h2 class="font-display text-lg font-bold mb-2 flex items-center gap-2">
                Maintenance Mode
                <% if (maintenanceOn) { %>
                <span class="px-2 py-0.5 rounded-full bg-amber-100 text-amber-700 text-xs font-semibold border border-amber-200">ACTIVE</span>
                <% } else { %>
                <span class="px-2 py-0.5 rounded-full bg-green-100 text-green-700 text-xs font-semibold border border-green-200">OFF (site live)</span>
                <% } %>
            </h2>
            <p class="text-sm text-navy-600 mb-4">When ON, all visitors see the maintenance page. Admin panel (/admin/*) stays accessible.</p>
            <form method="POST" action="/admin/site/maintenance">
                <input type="hidden" name="value" value="<%= maintenanceOn ? 'false' : 'true' %>">
                <button class="<%= maintenanceOn ? 'btn-secondary' : 'btn-primary' %>"><%= maintenanceOn ? 'Turn OFF Maintenance (Site Live)' : 'Turn ON Maintenance' %></button>
            </form>
            <p class="text-xs text-navy-500 mt-3">Note: saved to site content so the change persists on Vercel. Takes effect within a few seconds for new requests.</p>
        </div>
    </main>
</body>
</html>
