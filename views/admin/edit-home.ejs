<!DOCTYPE html>
<html lang="en">
<head>
    <% const pageTitle = 'Edit Home Page'; %>
    <%- include('_head', { pageTitle }) %>
</head>
<body class="bg-navy-50/30 text-navy-900 min-h-screen">
    <%- include('_sidebar') %>
    <%- include('_topbar') %>
    <main class="lg:ml-64 px-6 lg:px-10 py-8 lg:py-10 max-w-5xl">
        <%- include('_flash') %>

        <div class="flex items-center justify-between mb-8 gap-4 flex-wrap">
            <div>
                <h1 class="font-display text-3xl font-extrabold text-navy-900 mb-1">Edit Home Page</h1>
                <p class="text-navy-600">Update content shown on the public homepage.</p>
            </div>
            <a href="/" target="_blank" class="btn-secondary">View Public Site
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
        </div>

        <!-- Hero Slider Banner Manager (separate forms — must be outside main form) -->
        <details open class="card p-6 mb-5">
            <summary class="cursor-pointer font-display text-lg font-bold text-navy-900 flex items-center justify-between">
                Hero Banner Slider (<%= (content.home.hero.slides || []).length %> images)
                <svg class="w-5 h-5 text-navy-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="text-sm text-navy-500 mt-3 mb-4">Banner images rotate automatically every 5 seconds in the hero section. Recommended size: 1200×800 or larger, landscape orientation.</p>

            <% const slides = content.home.hero.slides || []; %>
            <% if (slides.length) { %>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
                <% slides.forEach((src, i) => { %>
                <div class="border border-navy-100 rounded-xl overflow-hidden bg-white">
                    <div class="aspect-video bg-navy-50 relative">
                        <img src="<%= src %>" class="w-full h-full object-cover">
                        <span class="absolute top-2 left-2 px-2 py-0.5 rounded-md bg-navy-950/70 text-white text-xs font-semibold backdrop-blur-sm">#<%= i + 1 %></span>
                    </div>
                    <div class="p-3 space-y-2">
                        <form method="POST" action="/admin/home/slides/replace" enctype="multipart/form-data" class="flex items-center gap-2">
                            <input type="hidden" name="index" value="<%= i %>">
                            <input type="file" name="slide" accept="image/*" required class="text-xs flex-1 min-w-0">
                            <button class="btn-primary !py-1.5 !px-3 !text-xs">Replace</button>
                        </form>
                        <div class="flex items-center justify-between gap-2">
                            <div class="flex gap-1">
                                <% if (i > 0) { %>
                                <form method="POST" action="/admin/home/slides/move">
                                    <input type="hidden" name="index" value="<%= i %>">
                                    <input type="hidden" name="dir" value="up">
                                    <button title="Move up" class="px-2 py-1 rounded border border-navy-200 hover:bg-navy-50 text-navy-700">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                                    </button>
                                </form>
                                <% } %>
                                <% if (i < slides.length - 1) { %>
                                <form method="POST" action="/admin/home/slides/move">
                                    <input type="hidden" name="index" value="<%= i %>">
                                    <input type="hidden" name="dir" value="down">
                                    <button title="Move down" class="px-2 py-1 rounded border border-navy-200 hover:bg-navy-50 text-navy-700">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                                    </button>
                                </form>
                                <% } %>
                            </div>
                            <form method="POST" action="/admin/home/slides/delete" onsubmit="return confirm('Remove banner image #<%= i + 1 %>?')">
                                <input type="hidden" name="index" value="<%= i %>">
                                <button class="btn-danger !py-1.5 !px-3 !text-xs">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
                <% }) %>
            </div>
            <% } else { %>
            <div class="rounded-xl border-2 border-dashed border-navy-200 p-8 text-center text-navy-500">No banner images yet. Add some below.</div>
            <% } %>

            <div class="mt-5 pt-5 border-t border-navy-100">
                <h4 class="font-semibold text-navy-900 mb-3">Add New Banner Image</h4>
                <form method="POST" action="/admin/home/slides/add" enctype="multipart/form-data" class="flex flex-wrap items-end gap-3">
                    <div class="flex-1 min-w-[240px]">
                        <input type="file" name="slide" accept="image/*" required class="text-sm">
                    </div>
                    <button class="btn-primary">Upload Banner</button>
                </form>
            </div>
        </details>

        <form method="POST" action="/admin/home" enctype="multipart/form-data" class="space-y-5">

            <!-- Site basics -->
            <details open class="card p-6">
                <summary class="cursor-pointer font-display text-lg font-bold text-navy-900 flex items-center justify-between">
                    Site Basics &amp; Top Bar
                    <svg class="w-5 h-5 text-navy-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="grid sm:grid-cols-2 gap-4 mt-5">
                    <div>
                        <label class="form-label">Phone (top bar)</label>
                        <input type="text" name="site_phone" value="<%= content.site.phone %>" class="form-input">
                    </div>
                    <div>
                        <label class="form-label">Email (top bar)</label>
                        <input type="text" name="site_email" value="<%= content.site.email %>" class="form-input">
                    </div>
                    <div>
                        <label class="form-label">Tagline (top bar right)</label>
                        <input type="text" name="site_tagline" value="<%= content.site.tagline %>" class="form-input">
                    </div>
                    <div>
                        <label class="form-label">Hero Badge ("Trusted Since...")</label>
                        <input type="text" name="site_trusted_since" value="<%= content.site.trusted_since %>" class="form-input">
                    </div>
                </div>
            </details>

            <!-- Hero -->
            <details open class="card p-6">
                <summary class="cursor-pointer font-display text-lg font-bold text-navy-900 flex items-center justify-between">
                    Hero Section
                    <svg class="w-5 h-5 text-navy-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="space-y-4 mt-5">
                    <div class="grid sm:grid-cols-3 gap-4">
                        <div>
                            <label class="form-label">Title (before highlight)</label>
                            <input type="text" name="hero_title_pre" value="<%= content.home.hero.title_pre %>" class="form-input">
                        </div>
                        <div>
                            <label class="form-label">Highlighted Words</label>
                            <input type="text" name="hero_title_highlight" value="<%= content.home.hero.title_highlight %>" class="form-input">
                        </div>
                        <div>
                            <label class="form-label">Title (after highlight)</label>
                            <input type="text" name="hero_title_post" value="<%= content.home.hero.title_post %>" class="form-input">
                        </div>
                    </div>
                    <div>
                        <label class="form-label">Description Paragraph</label>
                        <textarea name="hero_description" rows="3" class="form-input"><%= content.home.hero.description %></textarea>
                    </div>
                    <p class="text-xs text-navy-500 italic">ℹ️ Hero now uses the rotating banner slider (managed in the section above). To change banner images, scroll up to <strong>Hero Banner Slider</strong>. The page-bottom CTA buttons are edited in the <strong>CTA Banner</strong> section below.</p>
                </div>
            </details>

            <!-- Stats -->
            <details class="card p-6">
                <summary class="cursor-pointer font-display text-lg font-bold text-navy-900 flex items-center justify-between">
                    Stats Strip (4 items)
                    <svg class="w-5 h-5 text-navy-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="grid sm:grid-cols-2 gap-4 mt-5">
                    <% content.home.stats.forEach((s, i) => { %>
                    <div class="border border-navy-100 rounded-lg p-4 bg-navy-50/40">
                        <div class="text-xs font-semibold text-navy-500 uppercase tracking-wider mb-2">Stat <%= i + 1 %></div>
                        <div class="grid grid-cols-3 gap-2">
                            <input type="text" name="stats_value_<%= i %>" placeholder="Value" value="<%= s.value %>" class="form-input">
                            <input type="text" name="stats_suffix_<%= i %>" placeholder="Suffix (+)" value="<%= s.suffix %>" class="form-input">
                            <input type="text" name="stats_label_<%= i %>" placeholder="Label" value="<%= s.label %>" class="form-input col-span-3 mt-2">
                        </div>
                    </div>
                    <% }) %>
                </div>
            </details>

            <!-- About -->
            <details class="card p-6">
                <summary class="cursor-pointer font-display text-lg font-bold text-navy-900 flex items-center justify-between">
                    About Section
                    <svg class="w-5 h-5 text-navy-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="space-y-4 mt-5">
                    <div class="grid sm:grid-cols-3 gap-4">
                        <div><label class="form-label">Subtitle Pill</label><input type="text" name="about_subtitle" value="<%= content.home.about.subtitle %>" class="form-input"></div>
                        <div><label class="form-label">Title (before highlight)</label><input type="text" name="about_title_pre" value="<%= content.home.about.title_pre %>" class="form-input"></div>
                        <div><label class="form-label">Highlighted Words</label><input type="text" name="about_title_highlight" value="<%= content.home.about.title_highlight %>" class="form-input"></div>
                    </div>
                    <div><label class="form-label">Paragraph 1</label><textarea name="about_paragraph_1" rows="3" class="form-input"><%= content.home.about.paragraph_1 %></textarea></div>
                    <div><label class="form-label">Paragraph 2</label><textarea name="about_paragraph_2" rows="2" class="form-input"><%= content.home.about.paragraph_2 %></textarea></div>
                    <div><label class="form-label">Quote (in blue card)</label><textarea name="about_quote" rows="2" class="form-input"><%= content.home.about.quote %></textarea></div>

                    <div class="grid sm:grid-cols-2 gap-4">
                        <% content.home.about.features.forEach((feat, i) => { %>
                        <div class="border border-navy-100 rounded-lg p-4 bg-navy-50/40">
                            <div class="text-xs font-semibold text-navy-500 uppercase tracking-wider mb-2">Feature <%= i + 1 %></div>
                            <input type="text" name="about_feature_title_<%= i %>" placeholder="Title" value="<%= feat.title %>" class="form-input mb-2">
                            <textarea name="about_feature_desc_<%= i %>" rows="2" placeholder="Description" class="form-input"><%= feat.description %></textarea>
                        </div>
                        <% }) %>
                    </div>

                    <div class="grid sm:grid-cols-2 gap-4">
                        <div>
                            <label class="form-label">About Image 1</label>
                            <div class="flex items-center gap-3">
                                <img src="<%= content.home.about.image_1 %>" class="w-20 h-20 rounded-lg object-cover border border-navy-200">
                                <input type="file" name="about_image_1" accept="image/*" class="text-sm">
                            </div>
                        </div>
                        <div>
                            <label class="form-label">About Image 2</label>
                            <div class="flex items-center gap-3">
                                <img src="<%= content.home.about.image_2 %>" class="w-20 h-20 rounded-lg object-cover border border-navy-200">
                                <input type="file" name="about_image_2" accept="image/*" class="text-sm">
                            </div>
                        </div>
                    </div>
                </div>
            </details>

            <!-- Products header -->
            <details class="card p-6" open>
                <summary class="cursor-pointer font-display text-lg font-bold text-navy-900 flex items-center justify-between">
                    Products Section (Our Products & Solutions)
                    <svg class="w-5 h-5 text-navy-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="space-y-4 mt-5">
                    <label class="flex items-center gap-3 p-3 rounded-lg border border-navy-200 bg-navy-50/50 cursor-pointer">
                        <input type="checkbox" name="products_enabled" value="on" <%= (content.home.products_section.enabled !== false) ? 'checked' : '' %> class="w-5 h-5 accent-brand">
                        <div>
                            <div class="font-semibold text-navy-900 text-sm">Show this section on homepage</div>
                            <div class="text-xs text-navy-500">Uncheck to hide the entire "Our Products & Solutions" section (heading + cards).</div>
                        </div>
                    </label>
                    <p class="text-sm text-navy-500">Edit individual product cards on the <a href="/admin/products" class="text-brand font-semibold hover:underline">Products page</a>.</p>
                    <div class="grid sm:grid-cols-2 gap-4">
                        <div><label class="form-label">Subtitle Pill</label><input type="text" name="products_subtitle" value="<%= content.home.products_section.subtitle %>" class="form-input"></div>
                        <div><label class="form-label">Section Title (rename here)</label><input type="text" name="products_title" value="<%= content.home.products_section.title %>" class="form-input"></div>
                    </div>
                    <div><label class="form-label">Description</label><textarea name="products_description" rows="2" class="form-input"><%= content.home.products_section.description %></textarea></div>
                </div>
            </details>

            <!-- Why us -->
            <details class="card p-6">
                <summary class="cursor-pointer font-display text-lg font-bold text-navy-900 flex items-center justify-between">
                    Why Choose Us
                    <svg class="w-5 h-5 text-navy-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="space-y-4 mt-5">
                    <div class="grid sm:grid-cols-2 gap-4">
                        <div><label class="form-label">Subtitle Pill</label><input type="text" name="why_subtitle" value="<%= content.home.why_us.subtitle %>" class="form-input"></div>
                        <div><label class="form-label">Section Title</label><input type="text" name="why_title" value="<%= content.home.why_us.title %>" class="form-input"></div>
                    </div>
                    <div><label class="form-label">Description</label><textarea name="why_description" rows="2" class="form-input"><%= content.home.why_us.description %></textarea></div>
                    <div class="grid sm:grid-cols-3 gap-4">
                        <% content.home.why_us.items.forEach((item, i) => { %>
                        <div class="border border-navy-100 rounded-lg p-4 bg-navy-50/40">
                            <div class="text-xs font-semibold text-navy-500 uppercase tracking-wider mb-2">Pillar <%= i + 1 %></div>
                            <input type="text" name="why_item_title_<%= i %>" placeholder="Title" value="<%= item.title %>" class="form-input mb-2">
                            <textarea name="why_item_desc_<%= i %>" rows="3" placeholder="Description" class="form-input"><%= item.description %></textarea>
                        </div>
                        <% }) %>
                    </div>
                </div>
            </details>

            <!-- CTA -->
            <details class="card p-6">
                <summary class="cursor-pointer font-display text-lg font-bold text-navy-900 flex items-center justify-between">
                    CTA Banner
                    <svg class="w-5 h-5 text-navy-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="space-y-4 mt-5">
                    <div><label class="form-label">Title</label><input type="text" name="cta_title" value="<%= content.home.cta.title %>" class="form-input"></div>
                    <div><label class="form-label">Description</label><textarea name="cta_description" rows="2" class="form-input"><%= content.home.cta.description %></textarea></div>
                    <div class="grid sm:grid-cols-2 gap-4">
                        <div><label class="form-label">Primary Button Text</label><input type="text" name="cta_primary_text" value="<%= content.home.cta.primary_text %>" class="form-input"></div>
                        <div><label class="form-label">Primary Button Link</label><input type="text" name="cta_primary_href" value="<%= content.home.cta.primary_href %>" class="form-input"></div>
                        <div><label class="form-label">Secondary Button Text</label><input type="text" name="cta_secondary_text" value="<%= content.home.cta.secondary_text %>" class="form-input"></div>
                        <div><label class="form-label">Secondary Button Link</label><input type="text" name="cta_secondary_href" value="<%= content.home.cta.secondary_href %>" class="form-input"></div>
                    </div>
                </div>
            </details>

            <!-- Footer -->
            <details class="card p-6">
                <summary class="cursor-pointer font-display text-lg font-bold text-navy-900 flex items-center justify-between">
                    Footer
                    <svg class="w-5 h-5 text-navy-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="space-y-4 mt-5">
                    <div><label class="form-label">Description (under logo)</label><textarea name="footer_description" rows="2" class="form-input"><%= content.footer.description %></textarea></div>
                    <div class="grid sm:grid-cols-2 gap-4">
                        <div><label class="form-label">Address</label><input type="text" name="footer_address" value="<%= content.footer.address %>" class="form-input"></div>
                        <div><label class="form-label">Copyright Line</label><input type="text" name="footer_copyright" value="<%= content.footer.copyright %>" class="form-input"></div>
                    </div>
                </div>
            </details>

            <div class="sticky bottom-4 flex justify-end gap-3 bg-white/95 backdrop-blur p-4 rounded-2xl border border-navy-100 shadow-card">
                <a href="/admin" class="btn-secondary">Cancel</a>
                <button type="submit" class="btn-primary">Save Changes</button>
            </div>
        </form>
    </main>
</body>
</html>
