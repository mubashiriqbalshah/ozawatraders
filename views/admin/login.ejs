<!DOCTYPE html>
<html lang="en">
<head>
    <% const pageTitle = 'Admin Login'; %>
    <%- include('_head', { pageTitle }) %>
    <style>
        .login-bg {
            background:
                radial-gradient(ellipse at top right, rgba(59,130,246,0.2), transparent 50%),
                radial-gradient(ellipse at bottom left, rgba(30,58,138,0.3), transparent 50%),
                linear-gradient(135deg, #0a142b 0%, #0f1d33 50%, #1a2f4a 100%);
        }
    </style>
</head>
<body class="login-bg min-h-screen flex items-center justify-center px-6">
    <div class="w-full max-w-md">
        <div class="text-center mb-8">
            <div class="font-display text-3xl font-extrabold text-white tracking-tight mb-2"><%= content.site.name %></div>
            <h1 class="font-display text-base font-semibold text-blue-300 uppercase tracking-[0.2em]">Admin Panel</h1>
            <p class="text-navy-300 text-sm mt-2">Sign in to manage your site</p>
        </div>

        <div class="bg-white rounded-2xl shadow-2xl p-8">
            <% if (error) { %>
            <div class="mb-4 px-4 py-3 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm font-medium"><%= error %></div>
            <% } %>
            <form method="POST" action="/admin/login" class="space-y-4">
                <div>
                    <label class="block text-sm font-semibold text-navy-700 mb-1.5">Username</label>
                    <input type="text" name="username" required autofocus class="w-full px-4 py-3 rounded-lg border border-navy-200 focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-navy-700 mb-1.5">Password</label>
                    <input type="password" name="password" required class="w-full px-4 py-3 rounded-lg border border-navy-200 focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none">
                </div>
                <button type="submit" class="w-full px-6 py-3 bg-brand text-white rounded-lg font-semibold hover:bg-navy-800 transition shadow-md">Sign In</button>
            </form>
        </div>

        <p class="text-center text-navy-400 text-xs mt-6">Authorized personnel only.</p>
    </div>
</body>
</html>
